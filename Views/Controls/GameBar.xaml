<UserControl x:Class="Prism.Views.Controls.GameBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Prism.Core"
             xmlns:c="clr-namespace:Prism.Views.Controls">
    <!--
        Barre de contexte des pages qui operent sur un jeu. Le selecteur reste
        identique d'une page a l'autre : on ne perd jamais le fil de la cible.
    -->
    <StackPanel>
    <Border Style="{StaticResource S.Toolbar}">
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{l:T label.target}" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                          Width="290" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                    <c:StatusDot Status="{Binding Detail.Status}" />

                    <Border Style="{StaticResource S.VRule}" Height="14" Margin="12,0" />

                    <TextBlock Text="{Binding Detail.EngineLabel}" Style="{StaticResource T.Sec}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource S.VRule}" Height="14" Margin="12,0" />
                    <TextBlock Text="{Binding Detail.ExecutableName}" Style="{StaticResource T.Mono}"
                               Foreground="{DynamicResource BrFg2}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource Btn.Quiet}" Command="{Binding Detail.RefreshCommand}"
                        ToolTip="{l:T gamebar.rescan_tip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IcoRefresh}" Style="{StaticResource S.IconSm}"
                              Stroke="{DynamicResource BrFg2}" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T btn.rescan}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Btn.Quiet}" Command="{Binding Detail.OpenFolderCommand}"
                        ToolTip="{l:T gamebar.folder_tip}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IcoFolder}" Style="{StaticResource S.IconSm}"
                              Stroke="{DynamicResource BrFg2}" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T btn.folder}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

    <!-- Ce que Prism a deja pose dans ce jeu : visible sur chaque page, retirable d'un clic. -->
    <Border Background="{DynamicResource BrChrome}" BorderBrush="{DynamicResource BrLine}"
            BorderThickness="0,0,0,1" Padding="16,5"
            Visibility="{Binding Detail.HasAnyMods, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
        <c:InstalledStrip DataContext="{Binding Detail}" />
    </Border>
    </StackPanel>
</UserControl>
