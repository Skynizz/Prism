<UserControl x:Class="Prism.Views.Controls.StatusDot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!--
        Indicateur d'etat : un point de 6 px, un halo tres discret, un mot.
        Jamais de pastille pleine ni de fond colore.
    -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="10" Height="10" VerticalAlignment="Center">
            <Ellipse x:Name="Halo" Width="10" Height="10" Opacity="0.16"
                     Fill="{Binding Brush, ElementName=Root}" />
            <Ellipse Width="5" Height="5" Fill="{Binding Brush, ElementName=Root}" />
        </Grid>
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Style="{StaticResource T.Label}"
                   Foreground="{Binding Brush, ElementName=Root}"
                   Margin="6,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
