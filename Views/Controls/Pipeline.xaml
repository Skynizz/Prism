<UserControl x:Class="Prism.Views.Controls.Pipeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Prism.Core"
             x:Name="Root">
    <!--
        Chaine de rendu. Un etage emprunte par le pipeline porte un liseré accent et
        sa valeur technique ; un etage non emprunte reste en place, attenue, pour que
        la chaine complete reste lisible. Les etages s'etirent pour occuper toute la
        largeur, et passent a la ligne quand elle manque.
    -->
    <ItemsControl ItemsSource="{Binding Stages, ElementName=Root}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <l:StretchWrapPanel IsItemsHost="True" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Connecteur, sauf pour le premier maillon -->
                    <Grid Grid.Column="0" Width="20" Height="52"
                          Visibility="{Binding IsFirst, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Border Height="1" Width="20" VerticalAlignment="Center"
                                Background="{DynamicResource BrLine}" />
                        <Path Data="M0,0 L3.5,3.5 L0,7" Stretch="None" Width="4" Height="7"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Stroke="{DynamicResource BrLineHi}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource BrPanelAlt}"
                            BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource RdCtrl}"
                            Height="52" MinWidth="104" Opacity="{Binding NodeOpacity}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border Width="2" HorizontalAlignment="Left" CornerRadius="2,0,0,2"
                                    Background="{Binding State, Converter={StaticResource StatusBrush}}"
                                    Visibility="{Binding Engaged, Converter={StaticResource BoolVis}}" />

                            <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Label}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Mono}"
                                           FontSize="{DynamicResource SzSmall}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource BrFg}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
