<UserControl x:Class="Prism.Views.DlssPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Prism.Core"
             xmlns:c="clr-namespace:Prism.Views.Controls"
             FontFamily="{DynamicResource FontUi}">

    <UserControl.Resources>

        <!-- Ligne de voie selectionnable : liseré accent, jamais de bordure epaisse. -->
        <Style x:Key="PathRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsEnabled" Value="{Binding Available}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" Background="{DynamicResource BrPanelAlt}"
                                BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                                CornerRadius="{DynamicResource RdCtrl}">
                            <Grid>
                                <Border x:Name="Edge" Width="3" HorizontalAlignment="Left"
                                        Background="Transparent" CornerRadius="2,0,0,2" />
                                <ContentPresenter Margin="16,13,16,14" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrLineHi}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource BrRaise}" />
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrAccentDim}" />
                                <Setter TargetName="Edge" Property="Background" Value="{DynamicResource BrAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Ligne de prerequis : etat et intitule, valeur constatee sur toute la largeur
            restante, correctif a droite ; l'explication passe dessous (visible avec « ? »).
        -->
        <DataTemplate x:Key="PrereqRow">
            <Grid Margin="14,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="136" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0"
                             Fill="{Binding State, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource T.Mono}"
                           Foreground="{DynamicResource BrFg}" VerticalAlignment="Center"
                           Margin="0,0,12,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Detail}" />

                <Button Grid.Column="2" Content="{Binding FixLabel}" Style="{StaticResource Btn}"
                        VerticalAlignment="Center"
                        Visibility="{Binding Actionable, Converter={StaticResource BoolVis}}"
                        Command="{Binding DataContext.Detail.FixPrereqCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="{l:T prereq.fix_tip}" />

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Hint}"
                           Style="{StaticResource T.Prose}" Margin="0,4,0,0" />
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel>
        <c:GameBar DockPanel.Dock="Top" />

        <!-- Aucun titre selectionne -->
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource S.Empty}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Path Data="{DynamicResource IcoDlss}" Style="{StaticResource S.Icon}"
                  Stroke="{DynamicResource BrFgDim}" Width="36" Height="36" Stretch="Uniform"
                  HorizontalAlignment="Center" />
            <TextBlock Text="{l:T empty.no_target}" Style="{StaticResource T.Sec}"
                       HorizontalAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>

        <ScrollViewer Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="24,20,24,28" DataContext="{Binding Detail}">

                <TextBlock Text="DLSS Runtime" Style="{StaticResource T.Display}" />
                <TextBlock Style="{StaticResource T.Prose}" MaxWidth="760" Margin="0,6,0,0"
                           Text="{l:T dlss.intro}" />

                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,14,0,0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" />

                <!-- ============================================ DIAGNOSTIC -->
                <!--
                    Ce que le dernier lancement a reellement fait : l'overlay RenoDX peut dire
                    actif alors que la passe neurale a ete refusee. Lu dans ReShade.log.
                -->
                <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T diag.header}" Margin="0,18,0,0"
                                        Visibility="{Binding Diagnosis.Applies, Converter={StaticResource BoolVis}}">
                    <HeaderedContentControl.Tag>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Diagnosis.LogLabel}" Style="{StaticResource T.Sec}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <c:StatusDot Status="{Binding Diagnosis.State}" Text="{Binding Diagnosis.VerdictLabel}" />
                        </StackPanel>
                    </HeaderedContentControl.Tag>

                    <StackPanel Margin="16,14,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Diagnosis.Summary}" Style="{StaticResource T.Body}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{l:T diag.open_log}" Style="{StaticResource Btn.Quiet}"
                                        Command="{Binding OpenGameLogCommand}"
                                        Visibility="{Binding Diagnosis.HasLog, Converter={StaticResource BoolVis}}" />
                                <Button Content="{l:T diag.run}" Style="{StaticResource Btn}" Margin="6,0,0,0"
                                        Command="{Binding RunDiagnosisCommand}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Diagnosis.Findings}" Margin="0,12,0,0"
                                      Visibility="{Binding Diagnosis.HasFindings, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BrHair}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0"
                                                             Fill="{Binding State, Converter={StaticResource StatusBrush}}" />
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Strong}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Evidence}" Style="{StaticResource T.MonoPath}"
                                                           Margin="17,4,12,0" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Evidence}"
                                                           Visibility="{Binding HasEvidence, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding FixLabel}" Style="{StaticResource Btn}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasFix, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.Detail.ApplyDiagnosisFixCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </HeaderedContentControl>

                <!--
                    Deux colonnes des que la largeur le permet : DLSS 5 d'un cote, les runtimes de
                    l'autre ; chaque bloc rejoint la colonne la plus courte. Une seule en fenetre etroite.
                -->
                <l:AdaptiveColumns Margin="0,18,0,0" MinColumnWidth="600" MaxColumns="2" Gap="16">

                    <!-- ============================================== DLSS 5 -->
                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="DLSS 5 — NEURAL RENDERING">
                        <HeaderedContentControl.Tag>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Dlss5Progress}" Style="{StaticResource T.Sec}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <c:StatusDot Status="{Binding Dlss5Status}" />
                            </StackPanel>
                        </HeaderedContentControl.Tag>

                        <StackPanel Margin="16,14,16,16">
                            <TextBlock Text="{Binding Dlss5Summary}" Style="{StaticResource T.Prose}" MaxWidth="780" />

                            <TextBlock Text="{l:T dlss5.path}" Style="{StaticResource T.SectionLabel}" Margin="0,4,0,8" />

                            <ListBox ItemsSource="{Binding Dlss5Options}" SelectedItem="{Binding SelectedDlss5}"
                                     Style="{StaticResource S.Rows}" ItemContainerStyle="{StaticResource PathRow}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Strong}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0" />

                                                    <Border Style="{StaticResource S.Tag}"
                                                            BorderBrush="{DynamicResource BrAccentDim}"
                                                            Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="{l:T tag.recommended}" Style="{StaticResource T.Tag}"
                                                                   Foreground="{DynamicResource BrAccent}" />
                                                    </Border>

                                                    <Border Style="{StaticResource S.Tag}"
                                                            Visibility="{Binding NonDestructive, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="{l:T tag.nondestructive}" Style="{StaticResource T.Tag}" />
                                                    </Border>
                                                </WrapPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource S.Tag}"
                                                            ToolTip="{l:T dlss5.api_tip}">
                                                        <TextBlock Text="{Binding ApiLabel}" Style="{StaticResource T.Tag}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Version}" Style="{StaticResource T.Mono}"
                                                               Foreground="{DynamicResource BrFg}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Prose}"
                                                       Margin="0,8,0,0" MaxWidth="720" />

                                            <TextBlock Text="{Binding BlockedReason}" Style="{StaticResource T.Sec}"
                                                       Foreground="{DynamicResource BrWarn}" Margin="0,8,0,0"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding BlockedReason, Converter={StaticResource HasVis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{l:T label.prereqs}" Style="{StaticResource T.SectionLabel}" Margin="0,10,0,8" />
                            <Border Style="{StaticResource S.Sunken}" Padding="0,4">
                                <ItemsControl ItemsSource="{Binding Dlss5Checks}"
                                              ItemTemplate="{StaticResource PrereqRow}" />
                            </Border>

                            <!-- Build de l'addon RenoDX DLSS 5 : la plus recente par defaut. -->
                            <Border Style="{StaticResource S.Sunken}" Padding="14,10" Margin="0,12,0,0"
                                    Visibility="{Binding HasDlss5Builds, Converter={StaticResource BoolVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T dlss5.build}" Style="{StaticResource T.Label}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Dlss5Builds}" SelectedItem="{Binding SelectedDlss5Build}"
                                              MinWidth="260" ToolTip="{l:T dlss5.build_tip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinWidth="220">
                                                    <TextBlock Text="{Binding Version}" Style="{StaticResource T.Mono}" />
                                                    <TextBlock Text="{Binding Published, StringFormat={}{0:yyyy-MM-dd}}"
                                                               Style="{StaticResource T.Ter}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <!-- Action principale sur toute la largeur ; les secondaires dessous. -->
                            <Button Content="{l:T btn.install}" Style="{StaticResource Btn.Primary}"
                                    Margin="0,16,0,0" Height="40" HorizontalAlignment="Stretch"
                                    FontSize="{DynamicResource SzStrong}"
                                    Command="{Binding InstallDlss5Command}"
                                    ToolTip="{l:T dlss5.prepare_tip}" />
                            <UniformGrid Rows="1" Margin="0,8,0,0">
                                <Button Content="{l:T dlss5.adopt}" Style="{StaticResource Btn}" Margin="0,0,4,0"
                                        Command="{Binding AdoptNeuralCommand}"
                                        ToolTip="{l:T dlss5.adopt_tip}" />
                                <Button Content="{l:T btn.open_source}" Style="{StaticResource Btn}" Margin="4,0"
                                        Command="{Binding OpenSourceCommand}"
                                        CommandParameter="{Binding SelectedDlss5.SourceUrl}" />
                                <Button Content="{l:T dlss5.remove_bridge}" Style="{StaticResource Btn.Quiet}" Margin="4,0,0,0"
                                        Command="{Binding RemoveBridgeCommand}" />
                            </UniformGrid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- =================================== PANNEAUX DE RUNTIME -->
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <HeaderedContentControl Style="{StaticResource S.Box}" Margin="0,0,0,16"
                                                        Header="{Binding ShortLabel}">
                                    <HeaderedContentControl.Tag>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource S.Tag}"
                                                    BorderBrush="{DynamicResource BrAccentDim}"
                                                    Visibility="{Binding IsDeployed, Converter={StaticResource BoolVis}}"
                                                    ToolTip="{l:T dlss.added_tip}">
                                                <TextBlock Text="{l:T tag.added}" Style="{StaticResource T.Tag}"
                                                           Foreground="{DynamicResource BrAccent}" />
                                            </Border>
                                            <Border Style="{StaticResource S.Tag}"
                                                    BorderBrush="{DynamicResource BrAccentDim}"
                                                    Visibility="{Binding IsUpToDate, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{l:T tag.latest}" Style="{StaticResource T.Tag}"
                                                           Foreground="{DynamicResource BrAccent}" />
                                            </Border>
                                        </StackPanel>
                                    </HeaderedContentControl.Tag>

                                    <Grid Margin="16,14,16,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Intitule et version en place, lisibles d'un coup d'oeil. -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Strong}"
                                                           ToolTip="{Binding Tip}" />
                                                <TextBlock Text="{Binding FileName}" Style="{StaticResource T.Mono}"
                                                           Foreground="{DynamicResource BrFg3}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{l:T common.installed_cap}" Style="{StaticResource T.Label}"
                                                           HorizontalAlignment="Right" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <c:StatusDot Status="{Binding State}" Text="" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Mono}"
                                                               FontSize="{DynamicResource SzStrong}"
                                                               Foreground="{DynamicResource BrFg}" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Tip}" Style="{StaticResource T.Prose}"
                                                   MaxWidth="660" Margin="0,8,0,0" />

                                        <!-- Le meme bloc sert au remplacement et a l'ajout : seul le
                                             libelle du bouton principal change de sens. -->
                                        <Grid Grid.Row="2" Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="0" ItemsSource="{Binding Versions}"
                                                      SelectedItem="{Binding Selected}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid MinWidth="320">
                                                            <TextBlock Text="{Binding Version}"
                                                                       Style="{StaticResource T.Mono}"
                                                                       Foreground="{DynamicResource BrFg}" />
                                                            <TextBlock Text="{Binding InternalName}"
                                                                       Style="{StaticResource T.Ter}"
                                                                       HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button Grid.Column="1" Content="{Binding ActionLabel}"
                                                    Style="{StaticResource Btn.Primary}" MinWidth="110"
                                                    Margin="10,0,0,0" Command="{Binding ApplyCommand}"
                                                    ToolTip="{Binding ActionTip}" />
                                            <Button Grid.Column="2" Content="{l:T btn.restore}" Style="{StaticResource Btn.Quiet}"
                                                    Margin="6,0,0,0" Command="{Binding RestoreCommand}"
                                                    Visibility="{Binding IsDeployed, Converter={StaticResource BoolVis},
                                                                 ConverterParameter=invert}"
                                                    ToolTip="{l:T dlss.restore_tip}" />
                                            <Button Grid.Column="3" Content="{l:T btn.remove}" Style="{StaticResource Btn.Quiet}"
                                                    Margin="6,0,0,0" Command="{Binding RemoveCommand}"
                                                    Visibility="{Binding IsDeployed, Converter={StaticResource BoolVis}}"
                                                    ToolTip="{l:T dlss.remove_tip}" />
                                        </Grid>

                                        <ProgressBar Grid.Row="2" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                                     VerticalAlignment="Bottom" Margin="0,0,0,-12"
                                                     Visibility="{Binding Busy, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </HeaderedContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ============================================= EXPERT -->
                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T dlss.runtime_paths}"
                                            Visibility="{Binding DataContext.IsExpert,
                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                         Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding Game.Dlls}" Margin="16,10,16,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource T.Mono}"
                                                   Foreground="{DynamicResource BrFg}" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource T.MonoPath}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </HeaderedContentControl>
                </l:AdaptiveColumns>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
