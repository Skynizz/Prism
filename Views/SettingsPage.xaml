<UserControl x:Class="Prism.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Prism.Views.Controls"
             xmlns:l="clr-namespace:Prism.Core"
             x:Name="Page"
             FontFamily="{DynamicResource FontUi}">

    <!--
        Parametres ranges par rubrique, comme dans un outil de bureau : un menu a
        gauche, une seule rubrique a la fois a droite. La langue passe en premier.
    -->
    <DockPanel>

        <!-- ================================================== MENU -->
        <Border DockPanel.Dock="Left" Width="196" Background="{DynamicResource BrPanel}"
                BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{l:T nav.settings}" Style="{StaticResource T.Display}" Margin="18,0,0,14" />

                <!-- La rubrique ouverte vit dans le modele de vue : elle survit a un changement de theme. -->
                <ListBox x:Name="Sections" SelectedIndex="{Binding SettingsSection, Mode=TwoWay}"
                         Style="{StaticResource S.Rows}" ItemContainerStyle="{StaticResource S.Row}">
                    <ListBoxItem AutomationProperties.Name="language">
                        <StackPanel Orientation="Horizontal" Margin="6,9">
                            <Path Data="{DynamicResource IcoSettings}" Style="{StaticResource S.IconSm}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T set.sec.language}" Style="{StaticResource T.Sec}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="appearance">
                        <StackPanel Orientation="Horizontal" Margin="6,9">
                            <Path Data="{DynamicResource IcoOverview}" Style="{StaticResource S.IconSm}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T set.sec.appearance}" Style="{StaticResource T.Sec}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="library">
                        <StackPanel Orientation="Horizontal" Margin="6,9">
                            <Path Data="{DynamicResource IcoGames}" Style="{StaticResource S.IconSm}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T set.sec.library}" Style="{StaticResource T.Sec}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="backups">
                        <StackPanel Orientation="Horizontal" Margin="6,9">
                            <Path Data="{DynamicResource IcoRestore}" Style="{StaticResource S.IconSm}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T set.sec.backups}" Style="{StaticResource T.Sec}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="storage">
                        <StackPanel Orientation="Horizontal" Margin="6,9">
                            <Path Data="{DynamicResource IcoFolder}" Style="{StaticResource S.IconSm}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T set.sec.storage}" Style="{StaticResource T.Sec}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="safety">
                        <StackPanel Orientation="Horizontal" Margin="6,9">
                            <Path Data="{DynamicResource IcoWarn}" Style="{StaticResource S.IconSm}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T set.sec.safety}" Style="{StaticResource T.Sec}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ================================================ RUBRIQUES -->
        <ScrollViewer>
            <Grid Margin="22,18,22,24" MaxWidth="920" HorizontalAlignment="Left">

                <!-- ============================================== LANGUE -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Sections,
                                         Converter={StaticResource EqVis}, ConverterParameter=0}">
                    <TextBlock Text="{l:T set.sec.language}" Style="{StaticResource T.Title}" />
                    <TextBlock Text="{l:T set.language_hint}" Style="{StaticResource T.Prose}" Margin="0,5,0,0" />

                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T set.language_header}" Margin="0,16,0,0">
                        <HeaderedContentControl.Tag>
                            <TextBlock Text="{Binding SelectedLanguage.NativeName}" Style="{StaticResource T.Ter}" />
                        </HeaderedContentControl.Tag>

                        <ListBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                 Style="{StaticResource S.Rows}" ItemContainerStyle="{StaticResource S.Row}"
                                 Margin="0,4,0,4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NativeName}" Style="{StaticResource T.Strong}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding EnglishName}" Style="{StaticResource T.Ter}"
                                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Code}" Style="{StaticResource T.MonoDim}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </HeaderedContentControl>
                </StackPanel>

                <!-- ============================================== APPARENCE -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Sections,
                                         Converter={StaticResource EqVis}, ConverterParameter=1}">
                    <TextBlock Text="{l:T set.sec.appearance}" Style="{StaticResource T.Title}" />

                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T set.theme_header}" Margin="0,16,0,0">
                        <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                 Style="{StaticResource S.Rows}" ItemContainerStyle="{StaticResource S.Row}"
                                 Margin="0,4,0,4">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10">
                                        <TextBlock Style="{StaticResource T.Strong}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="theme.">
                                                    <Binding />
                                                    <Binding Path="Code" Source="{x:Static l:Loc.I}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource T.Ter}" Margin="0,3,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource LocKey}" ConverterParameter="theme.desc.">
                                                    <Binding />
                                                    <Binding Path="Code" Source="{x:Static l:Loc.I}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T set.details}" Margin="0,12,0,0">
                        <CheckBox Content="{l:T ui.details_tip}" IsChecked="{Binding ShowDetails}" Margin="14,14" />
                    </HeaderedContentControl>
                </StackPanel>

                <!-- ========================================= BIBLIOTHEQUES -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Sections,
                                         Converter={StaticResource EqVis}, ConverterParameter=2}">
                    <TextBlock Text="{l:T set.sec.library}" Style="{StaticResource T.Title}" />
                    <TextBlock Text="{l:T set.libraries_hint}" Style="{StaticResource T.Prose}" Margin="0,5,0,0" />

                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T set.libraries}" Margin="0,16,0,0">
                        <StackPanel Margin="14,12,14,14">
                            <ItemsControl ItemsSource="{Binding ExtraFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrSunken}"
                                                BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                                                CornerRadius="{DynamicResource RdCtrl}"
                                                Padding="10,0" Height="30" Margin="0,0,0,5">
                                            <Grid>
                                                <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}"
                                                           Foreground="{DynamicResource BrFg2}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                                                <Button Content="{l:T btn.remove}" Style="{StaticResource Btn.Quiet}" Height="22"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveFolderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="{l:T btn.add_folder}" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Command="{Binding AddFolderCommand}" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <!-- =========================================== SAUVEGARDES -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Sections,
                                         Converter={StaticResource EqVis}, ConverterParameter=3}">
                    <TextBlock Text="{l:T set.sec.backups}" Style="{StaticResource T.Title}" />
                    <TextBlock Text="{l:T set.backups_hint}" Style="{StaticResource T.Prose}" Margin="0,5,0,0" />

                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T set.backups}" Margin="0,16,0,0">
                        <HeaderedContentControl.Tag>
                            <TextBlock Text="{Binding BackupsSummary}" Style="{StaticResource T.Ter}" />
                        </HeaderedContentControl.Tag>

                        <StackPanel>
                            <Border Style="{StaticResource S.TableHead}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{l:T col.file}" Style="{StaticResource S.ColHeader}" />
                                    <TextBlock Grid.Column="1" Text="{l:T col.title}" Style="{StaticResource S.ColHeader}" />
                                    <TextBlock Grid.Column="2" Text="{l:T col.version}" Style="{StaticResource S.ColHeader}" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Backups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BrHair}" BorderThickness="0,0,0,1" Padding="12,0">
                                            <Grid Height="34">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="170" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding FileName}" Style="{StaticResource T.Mono}"
                                                           Foreground="{DynamicResource BrFg}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding GameName}" Style="{StaticResource T.Ter}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding FileVersion}" Style="{StaticResource T.Mono}"
                                                           Foreground="{DynamicResource BrFg3}" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Content="{l:T btn.restore}" Style="{StaticResource Btn}" Height="22"
                                                            IsEnabled="{Binding StillExists}"
                                                            Command="{Binding DataContext.RestoreBackupCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="{l:T btn.forget}" Style="{StaticResource Btn.Quiet}" Height="22"
                                                            Margin="4,0,0,0"
                                                            Command="{Binding DataContext.ForgetBackupCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <!-- ============================================== STOCKAGE -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Sections,
                                         Converter={StaticResource EqVis}, ConverterParameter=4}">
                    <TextBlock Text="{l:T set.sec.storage}" Style="{StaticResource T.Title}" />

                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T set.storage}" Margin="0,16,0,0">
                        <StackPanel Margin="14,12,14,14">
                            <Grid Margin="0,0,0,6">
                                <c:Field Label="{l:T label.backups}" Value="{Binding BackupsPath}" Mono="True" LabelWidth="110" />
                                <Button Content="{l:T btn.open}" Style="{StaticResource Btn.Quiet}" Height="22"
                                        HorizontalAlignment="Right"
                                        Command="{Binding OpenPathCommand}" CommandParameter="{Binding BackupsPath}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <c:Field Label="CACHE" Value="{Binding CachePath}" Mono="True" LabelWidth="110" />
                                <Button Content="{l:T btn.open}" Style="{StaticResource Btn.Quiet}" Height="22"
                                        HorizontalAlignment="Right"
                                        Command="{Binding OpenPathCommand}" CommandParameter="{Binding CachePath}" />
                            </Grid>
                            <Grid>
                                <c:Field Label="{l:T label.logs}" Value="{Binding LogsPath}" Mono="True" LabelWidth="110" />
                                <Button Content="{l:T btn.open}" Style="{StaticResource Btn.Quiet}" Height="22"
                                        HorizontalAlignment="Right"
                                        Command="{Binding OpenPathCommand}" CommandParameter="{Binding LogsPath}" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>

                <!-- =============================================== SECURITE -->
                <StackPanel Visibility="{Binding SelectedIndex, ElementName=Sections,
                                         Converter={StaticResource EqVis}, ConverterParameter=5}">
                    <TextBlock Text="{l:T set.sec.safety}" Style="{StaticResource T.Title}" />

                    <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T set.safety}" Margin="0,16,0,0">
                        <StackPanel Margin="14,12,14,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="{DynamicResource IcoWarn}" Style="{StaticResource S.IconSm}"
                                      Stroke="{DynamicResource BrWarn}" VerticalAlignment="Center" />
                                <TextBlock Text="{l:T set.anticheat}" Style="{StaticResource T.Strong}"
                                           Foreground="{DynamicResource BrWarn}" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource T.Prose}" Text="{l:T set.anticheat_hint}" />

                            <Border Style="{StaticResource S.HRule}" Margin="0,14,0,12" />

                            <TextBlock Text="{l:T set.integrity}" Style="{StaticResource T.Strong}" />
                            <TextBlock Style="{StaticResource T.Prose}" Margin="0,6,0,0" Text="{l:T set.integrity_hint}" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
