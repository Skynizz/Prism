<UserControl x:Class="Prism.Views.ComponentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Prism.Core"
             x:Name="Page"
             FontFamily="{DynamicResource FontUi}">

    <DockPanel>

        <!-- ================================================== BARRE D'OUTILS -->
        <Border DockPanel.Dock="Top" Style="{StaticResource S.Toolbar}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CatalogSummary}" Style="{StaticResource T.Ter}"
                               VerticalAlignment="Center" />
                    <Border Style="{StaticResource S.VRule}" Height="14" Margin="12,0" />
                    <TextBlock Text="{Binding RenoDxSummary}" Style="{StaticResource T.Ter}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Btn}"
                        Command="{Binding RefreshCatalogsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource IcoRefresh}" Style="{StaticResource S.IconSm}"
                              Stroke="{DynamicResource BrFg2}" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T btn.check_updates}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="20,18,20,24">

                <TextBlock Text="{l:T nav.components}" Style="{StaticResource T.Display}" />
                <TextBlock Style="{StaticResource T.Prose}" MaxWidth="760" Margin="0,5,0,0"
                           Text="{l:T comp.intro}" />

                <!-- ==================================================== TABLE -->
                <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T comp.sources}" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource S.TableHead}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="220" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:T col.component}" Style="{StaticResource S.ColHeader}" />
                                <TextBlock Grid.Column="1" Text="{l:T col.role}" Style="{StaticResource S.ColHeader}" />
                                <TextBlock Grid.Column="2" Text="{l:T col.version}" Style="{StaticResource S.ColHeader}" />
                                <TextBlock Grid.Column="3" Text="{l:T col.arch}" Style="{StaticResource S.ColHeader}" />
                                <TextBlock Grid.Column="4" Text="{l:T col.license}" Style="{StaticResource S.ColHeader}" />
                                <TextBlock Grid.Column="5" Text="{l:T col.stars}" Style="{StaticResource S.ColHeader}" />
                                <TextBlock Grid.Column="6" Text="{l:T col.last_commit}" Style="{StaticResource S.ColHeader}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Components}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BrHair}" BorderThickness="0,0,0,1"
                                            Padding="12,0">
                                        <StackPanel>
                                            <Grid Height="40">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="220" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource T.Body}"
                                                                   FontSize="{DynamicResource SzSmall}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Style="{StaticResource S.Tag}" Margin="8,0,0,0"
                                                                Visibility="{Binding NonDestructive,
                                                                             Converter={StaticResource BoolVis}}"
                                                                ToolTip="{l:T comp.inmemory_tip}">
                                                            <TextBlock Text="{l:T tag.inmemory}" Style="{StaticResource T.Tag}" />
                                                        </Border>
                                                        <Border Style="{StaticResource S.Tag}" Margin="4,0,0,0"
                                                                BorderBrush="{DynamicResource BrWarn}"
                                                                Visibility="{Binding IsStale,
                                                                             Converter={StaticResource BoolVis}}"
                                                                ToolTip="{l:T comp.stale_tip}">
                                                            <TextBlock Text="{l:T tag.stale}" Style="{StaticResource T.Tag}"
                                                                       Foreground="{DynamicResource BrWarn}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding HomeUrl}"
                                                               Style="{StaticResource T.MonoPath}" Margin="0,1,0,0" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding Role}"
                                                           Style="{StaticResource T.Ter}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2" Text="{Binding LatestVersion}"
                                                           Style="{StaticResource T.Mono}"
                                                           Foreground="{DynamicResource BrFg}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                                <TextBlock Grid.Column="3" Text="{Binding Architecture}"
                                                           Style="{StaticResource T.Mono}"
                                                           Foreground="{DynamicResource BrFg3}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="4" Text="{Binding License}"
                                                           Style="{StaticResource T.Mono}"
                                                           Foreground="{DynamicResource BrFg3}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="5" Text="{Binding StarsLabel}"
                                                           Style="{StaticResource T.Mono}"
                                                           Foreground="{DynamicResource BrFg2}"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FreshnessLabel}"
                                                               Style="{StaticResource T.Ter}"
                                                               VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource Btn.Icon}" Height="22" Width="22"
                                                            Margin="6,0,0,0" ToolTip="{l:T comp.open_tip}"
                                                            Command="{Binding DataContext.OpenUrlCommand,
                                                                      RelativeSource={RelativeSource
                                                                        AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding HomeUrl}">
                                                        <Path Data="{DynamicResource IcoExternal}"
                                                              Style="{StaticResource S.IconSm}"
                                                              Stroke="{DynamicResource BrFg3}"
                                                              Width="11" Height="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Note de confiance : visible a partir du mode Advanced -->
                                            <TextBlock Text="{Binding TrustNote}" Style="{StaticResource T.Prose}"
                                                       Margin="0,0,0,11" MaxWidth="820" HorizontalAlignment="Left"
                                                       Visibility="{Binding DataContext.IsAdvanced,
                                                                    ElementName=Page,
                                                                    Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- ============================================== CAPACITES -->
                <HeaderedContentControl Style="{StaticResource S.Box}" Header="{l:T comp.matrix}" Margin="0,12,0,0">
                    <StackPanel Margin="14,12,14,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="RTX 50 · BLACKWELL"
                                       Style="{StaticResource T.Label}" Margin="0,6" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource T.Sec}" Margin="0,6"
                                       Text="{l:T comp.rtx50}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="RTX 40 · ADA"
                                       Style="{StaticResource T.Label}" Margin="0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource T.Sec}" Margin="0,6"
                                       Text="{l:T comp.rtx40}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="RTX 30 · AMPERE"
                                       Style="{StaticResource T.Label}" Margin="0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource T.Sec}" Margin="0,6"
                                       Text="{l:T comp.rtx30}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="RTX 20 · TURING"
                                       Style="{StaticResource T.Label}" Margin="0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource T.Sec}" Margin="0,6"
                                       Text="{l:T comp.rtx20}" />
                        </Grid>

                        <TextBlock Style="{StaticResource T.Prose}" Margin="0,12,0,0"
                                   Text="{l:T comp.matrix_note}" />
                    </StackPanel>
                </HeaderedContentControl>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
