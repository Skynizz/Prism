<UserControl x:Class="Prism.Views.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Prism.Core"
             xmlns:c="clr-namespace:Prism.Views.Controls"
             x:Name="Page"
             FontFamily="{DynamicResource FontUi}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================== BARRE D'OUTILS -->
        <Border Grid.Row="0" Style="{StaticResource S.Toolbar}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="260">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 Tag="Filtrer les titres" Padding="28,0,8,0" />
                        <Path Data="{DynamicResource IcoSearch}" Style="{StaticResource S.IconSm}"
                              Stroke="{DynamicResource BrFg3}" Width="12" Height="12"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
                              IsHitTestVisible="False" />
                    </Grid>

                    <CheckBox Content="{l:T games.dlss_only}" IsChecked="{Binding OnlyModdable}"
                              VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GameCountLabel}" Style="{StaticResource T.Ter}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="{l:T library.add_game}" Style="{StaticResource Btn.Quiet}" Margin="0,0,6,0"
                            Command="{Binding AddGameCommand}" ToolTip="{l:T library.add_game_tip}" />
                    <Button Style="{StaticResource Btn}" Command="{Binding ScanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IcoRefresh}" Style="{StaticResource S.IconSm}"
                                  Stroke="{DynamicResource BrFg2}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T btn.rescan_library}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= TABLE + INSPECTEUR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource S.TableHead}" Padding="24,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition x:Name="ColPlatform" Width="100" />
                            <ColumnDefinition Width="Auto" MinWidth="210" />
                            <ColumnDefinition x:Name="ColRuntime" Width="96" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:T col.title}" Style="{StaticResource S.ColHeader}" />
                        <TextBlock Grid.Column="1" Text="{l:T col.platform}" Style="{StaticResource S.ColHeader}" />
                        <TextBlock Grid.Column="2" Text="{l:T col.capabilities}" Style="{StaticResource S.ColHeader}" />
                        <TextBlock Grid.Column="3" Text="{l:T col.runtime}" Style="{StaticResource S.ColHeader}" />
                        <TextBlock Grid.Column="4" Text="{l:T col.state}" Style="{StaticResource S.ColHeader}" />
                    </Grid>
                </Border>

                <!-- Etat vide -->
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource S.Empty}"
                            Visibility="{Binding Games.Count, Converter={StaticResource HasVis}, ConverterParameter=invert}">
                    <Path Data="{DynamicResource IcoGames}" Style="{StaticResource S.Icon}"
                          Stroke="{DynamicResource BrFgDim}" Width="28" Height="28" Stretch="Uniform"
                          HorizontalAlignment="Center" />
                    <TextBlock Text="{l:T games.empty}" Style="{StaticResource T.Sec}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource T.Prose}" MaxWidth="340" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               Text="{l:T games.empty_hint}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}"
                         Style="{StaticResource S.Rows}" ItemContainerStyle="{StaticResource S.Row}"
                         Padding="12,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="180" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" MinWidth="210" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>

                                <!-- Titre + chemin : deux niveaux dans une ligne dense -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}"
                                               FontSize="{DynamicResource SzSmall}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding InstallDir}" Style="{StaticResource T.MonoPath}"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding DataContext.Compact,
                                                            RelativeSource={RelativeSource AncestorType=ListBox},
                                                            Converter={StaticResource BoolVis},
                                                            ConverterParameter=invert}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Platform}"
                                           Style="{StaticResource T.Ter}" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource S.Tag}"
                                            Visibility="{Binding HasDlss, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="DLSS" Style="{StaticResource T.Tag}" /></Border>
                                    <Border Style="{StaticResource S.Tag}"
                                            Visibility="{Binding HasDlssG, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="FG" Style="{StaticResource T.Tag}" /></Border>
                                    <Border Style="{StaticResource S.Tag}"
                                            Visibility="{Binding HasDlssD, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="NR" Style="{StaticResource T.Tag}" /></Border>
                                    <Border Style="{StaticResource S.Tag}"
                                            Visibility="{Binding HasStreamline, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="SL" Style="{StaticResource T.Tag}" /></Border>
                                    <Border Style="{StaticResource S.Tag}" BorderBrush="{DynamicResource BrAccentDim}"
                                            Visibility="{Binding HasMfgUnlock, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="MFG" Style="{StaticResource T.Tag}"
                                                   Foreground="{DynamicResource BrAccent}" /></Border>
                                    <Border Style="{StaticResource S.Tag}" BorderBrush="{DynamicResource BrAccentDim}"
                                            Visibility="{Binding HasDlss5, Converter={StaticResource BoolVis}}"
                                            ToolTip="{l:T games.dlss5_tip}">
                                        <TextBlock Text="DLSS5" Style="{StaticResource T.Tag}"
                                                   Foreground="{DynamicResource BrAccent}" /></Border>
                                    <Border Style="{StaticResource S.Tag}"
                                            Visibility="{Binding HasReShade, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="RESHADE" Style="{StaticResource T.Tag}" /></Border>
                                    <Border Style="{StaticResource S.Tag}"
                                            Visibility="{Binding HasRenoDx, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="HDR" Style="{StaticResource T.Tag}" /></Border>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Style="{StaticResource T.Mono}"
                                           Foreground="{DynamicResource BrFg3}" VerticalAlignment="Center"
                                           Text="{Binding DlssVersionLabel}" />

                                <TextBlock Grid.Column="4" Style="{StaticResource T.Label}"
                                           VerticalAlignment="Center" Text="{Binding StateLabel}"
                                           Foreground="{DynamicResource BrFg3}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Inspecteur -->
            <Border Grid.Column="1" Width="400" Background="{DynamicResource BrChrome}"
                    BorderBrush="{DynamicResource BrLine}" BorderThickness="1,0,0,0"
                    Visibility="{Binding InspectorVisible, Converter={StaticResource BoolVis}}">
                <ScrollViewer>
                    <StackPanel Margin="16,16,16,20" DataContext="{Binding Detail}">

                        <TextBlock Text="{Binding Game.Name}" Style="{StaticResource T.Title}" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <c:StatusDot Status="{Binding Status}" />
                            <Border Style="{StaticResource S.VRule}" Height="12" Margin="10,0" />
                            <TextBlock Text="{Binding PlatformLabel}" Style="{StaticResource T.Ter}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Style="{StaticResource S.HRule}" Margin="0,14,0,12" />

                        <c:InstalledStrip />

                        <Border Style="{StaticResource S.HRule}" Margin="0,12,0,12" />

                        <TextBlock Text="{l:T label.identity}" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,8" />
                        <c:Field Label="{l:T label.engine}"  Value="{Binding EngineLabel}" LabelWidth="92" />
                        <c:Field Label="API"     Value="{Binding ApiLabel}" LabelWidth="92" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{l:T library.change_exe}" Style="{StaticResource Btn.Quiet}"
                                    Height="22" VerticalAlignment="Center" Command="{Binding ChooseExeCommand}"
                                    ToolTip="{l:T library.change_exe_tip}" />
                            <c:Field Label="{l:T label.binary}"  Value="{Binding ExecutableName}" Mono="True" LabelWidth="92" />
                        </DockPanel>
                        <c:Field Label="{l:T label.target}"  Value="{Binding TargetDir}" Mono="True" LabelWidth="92" />

                        <!-- Identite : nom officiel et AppID Steam, la cle des catalogues pour tout jeu. -->
                        <DockPanel Visibility="{Binding CanIdentify, Converter={StaticResource BoolVis}}">
                            <Button DockPanel.Dock="Right" Content="{l:T ident.identify}" Style="{StaticResource Btn.Quiet}"
                                    Height="22" VerticalAlignment="Center" Command="{Binding ToggleIdentifyCommand}"
                                    ToolTip="{l:T ident.identify_tip}" />
                            <c:Field Label="{l:T ident.header}" Value="{Binding IdentityLabel}" LabelWidth="92" />
                        </DockPanel>
                        <Border Style="{StaticResource S.Sunken}" Padding="10,9" Margin="0,6,0,0"
                                Visibility="{Binding Identifying, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:T ident.search}" Style="{StaticResource Btn}"
                                            Margin="6,0,0,0" Command="{Binding SearchIdentityCommand}" IsDefault="True" />
                                    <TextBox Text="{Binding IdentitySearch, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding IdentityCandidates}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel MinHeight="26">
                                                <Button DockPanel.Dock="Right" Content="{l:T ident.use}" Style="{StaticResource Btn.Quiet}"
                                                        Height="22" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.UseCandidateCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Body}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{l:T ident.custom}" Style="{StaticResource Btn.Quiet}" HorizontalAlignment="Left"
                                        Margin="0,6,0,0" Command="{Binding UseCustomNameCommand}" ToolTip="{l:T ident.custom_tip}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource S.HRule}" Margin="0,14,0,12" />

                        <TextBlock Text="{l:T games.runtimes}" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="26">
                                        <TextBlock Text="{Binding ShortLabel}" Style="{StaticResource T.Label}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InstalledVersion}"
                                                       Style="{StaticResource T.Mono}"
                                                       Foreground="{DynamicResource BrFg}" />
                                            <Border Style="{StaticResource S.Tag}" Margin="7,0,0,0"
                                                    BorderBrush="{DynamicResource BrAccentDim}"
                                                    Visibility="{Binding IsUpToDate, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{l:T tag.latest}" Style="{StaticResource T.Tag}"
                                                           Foreground="{DynamicResource BrAccent}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource S.HRule}" Margin="0,14,0,12" />

                        <TextBlock Text="{l:T label.injection}" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,8" />
                        <c:Field Label="{l:T label.method}"  Value="{Binding InjectionMethod}" LabelWidth="92" />
                        <c:Field Label="{l:T label.addons}" Value="{Binding InjectedAddons}" Mono="True" LabelWidth="92" />
                        <c:Field Label="RESHADE" Value="{Binding ReShadeStatus}" LabelWidth="92" />

                        <Border Style="{StaticResource S.HRule}" Margin="0,14,0,12" />

                        <Button Content="{l:T games.configure_dlss}" Style="{StaticResource Btn}" Margin="0,0,0,5"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.GoToCommand, ElementName=Page}" CommandParameter="2" />
                        <Button Content="{l:T games.configure_fg}" Style="{StaticResource Btn}" Margin="0,0,0,5"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.GoToCommand, ElementName=Page}" CommandParameter="3" />
                        <Button Content="{l:T games.injection_panel}" Style="{StaticResource Btn}" Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.GoToCommand, ElementName=Page}" CommandParameter="4" />

                        <Button Content="{l:T games.restore_originals}" Style="{StaticResource Btn.Danger}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RestoreEverythingCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
