<UserControl x:Class="Prism.Views.NexusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Prism.Views.Controls"
             xmlns:l="clr-namespace:Prism.Core"
             FontFamily="{DynamicResource FontUi}">

    <DockPanel>
        <c:GameBar DockPanel.Dock="Top" />

        <!-- ============================================== NAVIGATION -->
        <Border DockPanel.Dock="Top" Style="{StaticResource S.Toolbar}" DataContext="{Binding Nexus}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Quiet}" Click="OnBack" ToolTip="{l:T nexus.back}">
                        <Path Data="{DynamicResource IcoChevron}" Style="{StaticResource S.IconSm}"
                              Stroke="{DynamicResource BrFg2}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform Angle="90" /></Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource Btn.Quiet}" Click="OnForward" ToolTip="{l:T nexus.forward}">
                        <Path Data="{DynamicResource IcoChevron}" Style="{StaticResource S.IconSm}"
                              Stroke="{DynamicResource BrFg2}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource Btn.Quiet}" Click="OnReload" ToolTip="{l:T nexus.reload}">
                        <Path Data="{DynamicResource IcoRefresh}" Style="{StaticResource S.IconSm}"
                              Stroke="{DynamicResource BrFg2}" />
                    </Button>
                    <Button Style="{StaticResource Btn.Quiet}" Click="OnHome" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{DynamicResource IcoGames}" Style="{StaticResource S.IconSm}"
                                  Stroke="{DynamicResource BrFg2}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T nexus.home}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Url}" Style="{StaticResource T.MonoDim}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="14,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Quiet}" Command="{Binding ToggleAccountCommand}" Margin="0,0,12,0"
                            ToolTip="{l:T nexus.acct.tip}">
                        <TextBlock Text="{Binding AccountLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPremium}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <ProgressBar Width="110" Height="4" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding Status}" MaxWidth="560" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" ToolTip="{Binding Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Sec}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrErr}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Prose}" Margin="16,8,16,0"
                   Text="{l:T nexus.help}" />

        <!-- ========================================== COMPTE NEXUS -->
        <Border DockPanel.Dock="Top" Style="{StaticResource S.Notice}" Margin="16,10,16,0" DataContext="{Binding Nexus}"
                Visibility="{Binding ShowAccount, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource T.Strong}" />
                <TextBlock Text="{l:T nexus.acct.help}" Style="{StaticResource T.Sec}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <PasswordBox x:Name="KeyBox" Width="360" PasswordChanged="OnKeyChanged" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.Primary}" Content="{l:T nexus.acct.save}" Margin="8,0,0,0"
                            Command="{Binding SaveKeyCommand}" />
                    <Button Style="{StaticResource Btn.Base}" Content="{l:T nexus.acct.get_key}" Margin="8,0,0,0"
                            Command="{Binding OpenKeysPageCommand}" />
                    <Button Style="{StaticResource Btn.Quiet}" Content="{l:T nexus.acct.forget}" Margin="8,0,0,0"
                            Command="{Binding ForgetKeyCommand}"
                            Visibility="{Binding HasKey, Converter={StaticResource BoolVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding AccountError}" Foreground="{DynamicResource BrErr}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ========================================= MODS INSTALLES -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrChrome}" BorderBrush="{DynamicResource BrLine}"
                BorderThickness="0,0,0,1" Padding="16,5" DataContext="{Binding Nexus}"
                Visibility="{Binding HasInstalledMods, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Primary}" Content="{Binding UpdateAllLabel}"
                                Command="{Binding UpdateAllCommand}" ToolTip="{l:T nexus.mods.update_all_tip}"
                                Visibility="{Binding HasUpdates, Converter={StaticResource BoolVis}}" />
                        <Button Style="{StaticResource Btn.Quiet}" Content="{l:T nexus.mods.check}" Margin="8,0,0,0"
                                Command="{Binding CheckUpdatesCommand}" />
                        <Button Style="{StaticResource Btn.Quiet}" Content="{l:T nexus.mods.details}" Margin="4,0,0,0"
                                Command="{Binding ToggleInstalledCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding InstalledHeader}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdates}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrWarn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding InstalledMods}" Margin="0,6,0,2"
                              Visibility="{Binding ShowInstalled, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:StatusDot Status="{Binding Status}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding InstalledVersion}" Style="{StaticResource T.MonoDim}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding StateLabel}" Style="{StaticResource T.Sec}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="4" Style="{StaticResource Btn.Quiet}" Content="{l:T nexus.mods.update}"
                                        Command="{Binding UpdateCommand}"
                                        Visibility="{Binding CanUpdate, Converter={StaticResource BoolVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============================================== PREREQUIS -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrChrome}" BorderBrush="{DynamicResource BrLine}"
                BorderThickness="0,0,0,1" Padding="16,5" DataContext="{Binding Nexus}"
                Visibility="{Binding OnModPage, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding RequirementsHeader}"
                           VerticalAlignment="Center" MinWidth="124" Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMissing}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BrWarn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Un clic par fichier, impose par Nexus : Prism ouvre chaque prerequis et enchaine. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource Btn.Primary}" Content="{Binding DownloadAllLabel}"
                            Command="{Binding DownloadAllCommand}" ToolTip="{l:T nexus.req.download_all_tip}"
                            Visibility="{Binding HasMissing, Converter={StaticResource BoolVis}}" />
                    <Button Style="{StaticResource Btn.Quiet}" Content="{l:T nexus.req.stop}" Margin="8,0,0,0"
                            Command="{Binding StopQueueCommand}"
                            Visibility="{Binding QueueActive, Converter={StaticResource BoolVis}}" />
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{l:T nexus.req.none}" Style="{StaticResource T.Ter}" VerticalAlignment="Center"
                               Visibility="{Binding NoRequirements, Converter={StaticResource BoolVis}}" />
                    <ItemsControl ItemsSource="{Binding Requirements}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource S.Sunken}" Padding="9,2,3,2" Margin="0,3,6,3"
                                        ToolTip="{Binding Notes}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:StatusDot Status="{Binding Status}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource T.Ter}" Margin="7,0,4,0"
                                                   VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Btn.Quiet}" Content="{l:T nexus.req.open}"
                                                Command="{Binding OpenCommand}"
                                                Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================== EMPLACEMENT A CHOISIR -->
        <Border DockPanel.Dock="Top" Style="{StaticResource S.Notice}" Margin="16,10,16,0" DataContext="{Binding Nexus}"
                Visibility="{Binding HasPending, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Btn.Primary}" Content="{l:T nexus.to_root}"
                            Command="{Binding InstallToRootCommand}" />
                    <Button Style="{StaticResource Btn.Base}" Content="{l:T nexus.to_exe}" Margin="8,0,0,0"
                            Command="{Binding InstallToExeCommand}" />
                    <Button Style="{StaticResource Btn.Quiet}" Content="{l:T reset.cancel}" Margin="8,0,0,0"
                            Command="{Binding DismissCommand}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding PendingTitle}" Style="{StaticResource T.Strong}" />
                    <TextBlock Text="{Binding PendingNote}" Style="{StaticResource T.Sec}" Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="130" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.MonoDim}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================================================= SITE -->
        <Grid Margin="0,10,0,0">
            <ContentControl x:Name="Host" />
            <StackPanel Style="{StaticResource S.Empty}" DataContext="{Binding Nexus}"
                        Visibility="{Binding RuntimeMissing, Converter={StaticResource BoolVis}}">
                <Path Data="{DynamicResource IcoNexus}" Style="{StaticResource S.Icon}"
                      Stroke="{DynamicResource BrFgDim}" Width="28" Height="28" Stretch="Uniform"
                      HorizontalAlignment="Center" />
                <TextBlock Text="{l:T nexus.runtime_missing}" Style="{StaticResource T.Sec}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                <Button Style="{StaticResource Btn.Base}" Content="{l:T nexus.runtime_get}" Click="OnGetRuntime"
                        HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
