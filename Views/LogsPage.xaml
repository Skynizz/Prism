<UserControl x:Class="Prism.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Prism.Core"
             x:Name="Page"
             FontFamily="{DynamicResource FontUi}">

    <DockPanel>

        <!-- ================================================== BARRE D'OUTILS -->
        <Border DockPanel.Dock="Top" Style="{StaticResource S.Toolbar}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="280">
                        <TextBox Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                 Tag="Filtrer le journal" Padding="28,0,8,0" />
                        <Path Data="{DynamicResource IcoSearch}" Style="{StaticResource S.IconSm}"
                              Stroke="{DynamicResource BrFg3}" Width="12" Height="12"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"
                              IsHitTestVisible="False" />
                    </Grid>

                    <TextBlock Text="{l:T label.severity}" Style="{StaticResource T.Label}" Margin="18,0,9,0"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding MinLevel}" Width="104" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{l:T btn.export}" Style="{StaticResource Btn}" Command="{Binding ExportLogCommand}" />
                    <Button Content="{l:T btn.clear}" Style="{StaticResource Btn.Quiet}" Margin="6,0,0,0"
                            Command="{Binding ClearLogCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pied : fichier courant -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrChrome}"
                BorderBrush="{DynamicResource BrLine}" BorderThickness="0,1,0,0" Padding="16,7">
            <Grid>
                <TextBlock Text="{Binding LogsPath}" Style="{StaticResource T.MonoPath}"
                           VerticalAlignment="Center" />
                <Button Content="{l:T btn.open_folder}" Style="{StaticResource Btn.Quiet}" Height="22"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenPathCommand}" CommandParameter="{Binding LogsPath}" />
            </Grid>
        </Border>

        <!--
            Console. Fond enfonce, gouttiere de severite, colonnes fixes :
            horodatage, niveau, source, message. Selection et copie possibles.
        -->
        <Border Background="{DynamicResource BrSunken}" Margin="16,14,16,14"
                BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                CornerRadius="{DynamicResource RdPanel}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource S.TableHead}"
                        Background="{DynamicResource BrPanelAlt}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:T col.time}" Style="{StaticResource S.ColHeader}" />
                        <TextBlock Grid.Column="1" Text="{l:T col.level}" Style="{StaticResource S.ColHeader}" />
                        <TextBlock Grid.Column="2" Text="{l:T col.source}" Style="{StaticResource S.ColHeader}" />
                        <TextBlock Grid.Column="3" Text="{l:T col.message}" Style="{StaticResource S.ColHeader}" />
                    </Grid>
                </Border>

                <ListBox ItemsSource="{Binding LogView}" Style="{StaticResource S.Rows}"
                         Padding="12,4,6,6"
                         SelectionMode="Extended">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="B" Background="Transparent" Padding="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="B" Property="Background"
                                                        Value="{DynamicResource BrPanel}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="B" Property="Background"
                                                        Value="{DynamicResource BrRaise}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="19">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Time}"
                                           Style="{StaticResource T.Mono}"
                                           FontSize="{DynamicResource SzLabel}"
                                           Foreground="{DynamicResource BrFgDim}" />

                                <TextBlock Grid.Column="1" Text="{Binding LevelTag}"
                                           Style="{StaticResource T.Mono}"
                                           FontSize="{DynamicResource SzLabel}"
                                           Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />

                                <TextBlock Grid.Column="2" Text="{Binding Source}"
                                           Style="{StaticResource T.Mono}"
                                           FontSize="{DynamicResource SzLabel}"
                                           Foreground="{DynamicResource BrFg3}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                                <TextBlock Grid.Column="3" Text="{Binding Message}"
                                           Style="{StaticResource T.Mono}"
                                           FontSize="{DynamicResource SzLabel}"
                                           Foreground="{DynamicResource BrFg2}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
