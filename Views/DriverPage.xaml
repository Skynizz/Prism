<UserControl x:Class="Prism.Views.DriverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Prism.Views.Controls"
             xmlns:l="clr-namespace:Prism.Core"
             FontFamily="{DynamicResource FontUi}">

    <DockPanel>
        <c:GameBar DockPanel.Dock="Top" />

        <StackPanel DockPanel.Dock="Top" Style="{StaticResource S.Empty}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Path Data="{DynamicResource IcoDriver}" Style="{StaticResource S.Icon}"
                  Stroke="{DynamicResource BrFgDim}" Width="28" Height="28" Stretch="Uniform"
                  HorizontalAlignment="Center" />
            <TextBlock Text="{l:T empty.no_target}" Style="{StaticResource T.Sec}"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
            <StackPanel Margin="20,18,20,24" DataContext="{Binding Driver}">

                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Content="{l:T drv.reset}"
                            Command="{Binding ResetCommand}" ToolTip="{l:T drv.reset_tip}" VerticalAlignment="Bottom" />
                    <StackPanel>
                        <TextBlock Text="{l:T nav.driver}" Style="{StaticResource T.Display}" />
                        <TextBlock Text="{Binding ProfileLabel}" Style="{StaticResource T.MonoDim}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource T.Prose}" MaxWidth="740" Margin="0,5,0,0" Text="{l:T drv.intro}" />

                <Border Style="{StaticResource S.Notice}" Margin="0,14,0,0"
                        Visibility="{Binding Available, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <TextBlock Text="{l:T drv.unavailable}" Style="{StaticResource T.Sec}" TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource S.Notice}" Margin="0,14,0,0"
                        Visibility="{Binding ShowAdminNote, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Content="{l:T drv.relaunch_admin}"
                                Command="{Binding RelaunchAdminCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Text="{l:T drv.admin_note}" Style="{StaticResource T.Sec}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}"
                              Visibility="{Binding Available, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <HeaderedContentControl Style="{StaticResource S.Box}" Header="{Binding Label}" Margin="0,14,0,0">
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="14,6,14,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BrHair}" BorderThickness="0,0,0,1" Padding="0,9">
                                                <DockPanel>
                                                    <ComboBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center"
                                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource T.Strong}" />
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource T.Ter}" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </HeaderedContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
