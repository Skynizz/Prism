<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:Prism.Core">

    <!-- Convertisseurs -->
    <core:BoolToVisibility x:Key="BoolVis" />
    <core:HasValueToVisibility x:Key="HasVis" />
    <core:InverseBool x:Key="NotBool" />
    <core:ByteSize x:Key="ByteSize" />
    <core:StatusToBrush x:Key="StatusBrush" />
    <core:LocKey x:Key="LocKey" />
    <core:LevelToBrush x:Key="LevelBrush" />
    <core:EqualityToBool x:Key="EqBool" />
    <core:MultiEquality x:Key="MultiEq" />
    <core:MultiplierTip x:Key="MultTip" />
    <core:EqualityToVisibility x:Key="EqVis" />

    <!-- ==================================================== TEXTE ========= -->

    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzBody}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}" />

    <Style x:Key="T.Display" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource FontUiTight}" />
        <Setter Property="FontSize" Value="{DynamicResource SzDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.Title" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource FontUiTight}" />
        <Setter Property="FontSize" Value="{DynamicResource SzTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.Strong" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="{DynamicResource SzStrong}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock" BasedOn="{StaticResource T.Base}" />

    <Style x:Key="T.Sec" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
    </Style>

    <Style x:Key="T.Ter" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{DynamicResource BrFg3}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
    </Style>

    <Style x:Key="T.Prose" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <!-- Sans cela, MaxWidth centre le paragraphe dans son conteneur etire. -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <!-- Libelle de champ : petites capitales espacees, le marqueur visuel des
         outils techniques. -->
    <Style x:Key="T.Label" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{DynamicResource BrFg3}" />
        <Setter Property="FontSize" Value="{DynamicResource SzLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
        <Setter Property="Foreground" Value="{DynamicResource BrFg3}" />
    </Style>

    <!-- Monospace : uniquement versions, chemins, valeurs techniques et journaux. -->
    <Style x:Key="T.Mono" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
    </Style>

    <Style x:Key="T.MonoDim" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
    </Style>

    <Style x:Key="T.MonoPath" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
        <Setter Property="Foreground" Value="{DynamicResource BrFg3}" />
        <Setter Property="FontSize" Value="{DynamicResource SzLabel}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- =================================================== SURFACES ======= -->

    <Style x:Key="S.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RdPanel}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrPanelAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.Sunken" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RdCtrl}" />
    </Style>

    <Style x:Key="S.HRule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrHair}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.VRule" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrHair}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Encart d'avertissement : fond tres sombre teinte, jamais de bloc sature. -->
    <Style x:Key="S.Notice" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrWarnBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrWarn}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource RdCtrl}" />
        <Setter Property="Padding" Value="11,9" />
    </Style>

    <!-- ===================================================== ICONES ======= -->

    <Style x:Key="S.Icon" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource BrFg2}" />
        <Setter Property="StrokeThickness" Value="1.25" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.IconSm" TargetType="Path" BasedOn="{StaticResource S.Icon}">
        <Setter Property="StrokeThickness" Value="1.1" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- ================================================== INFOBULLES ===== -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource BrRaise}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLineHi}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RdCtrl}"
                            Padding="10,8" MaxWidth="320">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="T.Tip" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
    </Style>

    <!-- ================================================ DEFILEMENT ======= -->

    <Style x:Key="S.ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="B" Background="#2C323A" CornerRadius="1.5" Margin="3,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#3D444D" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#4A525C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="9" />
        <Setter Property="MinWidth" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource S.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="9" />
                            <Setter Property="MinHeight" Value="9" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <!-- =============================================== PROGRESSION ======= -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource BrAccent}" />
        <Setter Property="Background" Value="{DynamicResource BrHair}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
