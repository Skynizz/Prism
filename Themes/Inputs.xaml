<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =================================================== BOUTONS ======== -->

    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{DynamicResource CtrlH}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="B"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RdCtrl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrRaise}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrLineHi}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrPanelAlt}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrAccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton standard : contour, jamais de remplissage plein. -->
    <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource BrPanelAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Btn}" />

    <!--
        Action principale : liseré accent a gauche plutot qu'un aplat vert.
        Un bouton entierement vert ferait "bouton de telechargement", pas outil.
    -->
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="Background" Value="{DynamicResource BrAccentBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrAccentDim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RdCtrl}">
                        <Grid>
                            <Border x:Name="Edge" Width="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource BrAccent}"
                                    CornerRadius="2,0,0,2" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#1D2709" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#141B06" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Quiet" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="9,0" />
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrErr}" />
        <Setter Property="BorderBrush" Value="#3A1E1A" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Bouton icone carre, pour les barres d'outils. -->
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Boutons de fenetre : zone de clic large, rendu minimal. -->
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrRaise}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#B3352A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== CHAMPS ======== -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="CaretBrush" Value="{DynamicResource BrAccent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrAccentDim}" />
        <Setter Property="Background" Value="{DynamicResource BrSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{DynamicResource CtrlH}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RdCtrl}">
                        <Grid>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       Foreground="{DynamicResource BrFgDim}"
                                       FontSize="{DynamicResource SzSmall}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrLineHi}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrAccentDim}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}" Value="0">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================== CASE A COCHER ===== -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                Background="{DynamicResource BrSunken}"
                                BorderBrush="{DynamicResource BrLineHi}" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Tick" Data="{DynamicResource IcoCheck}" Stretch="Uniform"
                                  Margin="2.5" Stroke="{DynamicResource BrOnAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrAccent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrAccentDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================== BASCULE ======= -->

    <!-- Interrupteur ON/OFF compact, pour les reglages binaires d'un profil. -->
    <Style x:Key="Toggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="9"
                            Background="{DynamicResource BrSunken}"
                            BorderBrush="{DynamicResource BrLineHi}" BorderThickness="1">
                        <Border x:Name="Knob" Width="12" Height="12" CornerRadius="6"
                                Background="{DynamicResource BrFg3}"
                                HorizontalAlignment="Left" Margin="2,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrAccentBg}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrAccent}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource BrAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================= SEGMENTE ======== -->

    <!--
        Selecteur segmente : utilise pour les multiplicateurs (x2..x6) et le niveau
        de detail. Les elements sont jointifs, separes par un simple trait.
    -->
    <Style x:Key="Seg.Item" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrRaise}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrAccentBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Seg.Host" TargetType="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{DynamicResource BrSunken}"
                            BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource RdCtrl}" SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================ LISTE DEROULANTE ===== -->

    <ControlTemplate x:Key="Combo.Toggle" TargetType="ToggleButton">
        <Border x:Name="B" Background="{DynamicResource BrSunken}"
                BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                CornerRadius="{DynamicResource RdCtrl}" SnapsToDevicePixels="True" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrLineHi}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrAccentDim}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="Height" Value="{DynamicResource CtrlH}" />
        <Setter Property="Padding" Value="9,0,26,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource Combo.Toggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- Liaison explicite : un TemplateBinding ne capte pas le gabarit
                             genere pour la zone de selection. -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                            RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentStringFormat="{Binding SelectionBoxItemStringFormat,
                                                                RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsHitTestVisible="False" />

                        <Path Data="{DynamicResource IcoChevron}" Stretch="Uniform" Width="8" Height="8"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                              Stroke="{DynamicResource BrFg3}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              IsHitTestVisible="False" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               Placement="Bottom" VerticalOffset="3"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Background="{DynamicResource BrRaise}"
                                    BorderBrush="{DynamicResource BrLineHi}" BorderThickness="1"
                                    CornerRadius="{DynamicResource RdCtrl}"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" Padding="3">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="B" Background="Transparent" CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrPanelAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrAccentBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource BrAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
