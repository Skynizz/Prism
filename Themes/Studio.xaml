<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:Prism.Core">

    <!--
        THEME STUDIO — couche de styles
        ===============================
        Chargee apres Base, Inputs et Data, elle remplace les styles de meme cle pour les
        elements crees ensuite. Aucune fonctionnalite ajoutee : surfaces plus calmes,
        typographie plus legere, transitions de 150 a 250 ms.

        Autonome par construction : aucune StaticResource vers un autre dictionnaire,
        car cette couche est chargee a l'execution.
    -->

    <!-- ==================================================== TEXTE ========= -->

    <Style x:Key="T.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUiTight}" />
        <Setter Property="FontSize" Value="{DynamicResource SzDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUiTight}" />
        <Setter Property="FontSize" Value="{DynamicResource SzTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.Strong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzStrong}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg3}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T.Prose" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowDetails, Source={x:Static core:UiPrefs.I}}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="T.Tag" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzMicro}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="S.ColHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- =================================================== SURFACES ======= -->

    <Style x:Key="S.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrHair}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RdPanel}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.PanelHeader" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrHair}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Height" Value="42" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.Sunken" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrHair}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RdCtrl}" />
    </Style>

    <Style x:Key="S.Notice" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrWarnBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RdCtrl}" />
        <Setter Property="Padding" Value="14,11" />
    </Style>

    <!--
        Panneau titre : plus de bandeau d'en-tete colore. Le titre de section, en
        semi-gras, et un simple filet suffisent a structurer.
    -->
    <Style x:Key="S.Box" TargetType="HeaderedContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{DynamicResource BrPanel}"
                            BorderBrush="{DynamicResource BrHair}" BorderThickness="1"
                            CornerRadius="{DynamicResource RdPanel}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="46" Padding="18,0"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BrHair}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" />
                                    <ContentPresenter Content="{TemplateBinding Tag}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="4,2,4,4" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{DynamicResource FontUi}"
                               FontSize="{DynamicResource SzSmall}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrFg}"
                               TextOptions.TextFormattingMode="Ideal" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.TableHead" TargetType="Border">
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrHair}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.Tag" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.Toolbar" TargetType="Border">
        <Setter Property="Height" Value="52" />
        <Setter Property="Background" Value="{DynamicResource BrBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrHair}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="S.Empty" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,72" />
    </Style>

    <!-- ================================================== LIGNES ========== -->

    <!-- Survol et selection en fondu ; la selection garde un liseré vert a peine visible. -->
    <Style x:Key="S.Row" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" Background="Transparent"
                            BorderBrush="{DynamicResource BrHair}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource BrFg}" Opacity="0" />
                            <Border x:Name="Sel" Background="{DynamicResource BrRaise}" Opacity="0" />
                            <Border x:Name="Edge" Width="2" HorizontalAlignment="Left" Margin="0,8"
                                    CornerRadius="1" Background="{DynamicResource BrAccent}" Opacity="0" />
                            <ContentPresenter Margin="16,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.035" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity"
                                                         To="0.85" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Edge" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.RowStatic" TargetType="ListBoxItem" BasedOn="{StaticResource S.Row}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Entree du rail : pastille arrondie qui apparait en fondu, sans liseré. -->
    <Style x:Key="NavRow" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Height="{DynamicResource NavRowH}" Margin="10,1">
                        <Border x:Name="Sel" Background="{DynamicResource BrRaise}"
                                CornerRadius="{DynamicResource RdCtrl}" Opacity="0" />
                        <Border x:Name="Hover" Background="{DynamicResource BrFg}"
                                CornerRadius="{DynamicResource RdCtrl}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Path x:Name="Ico" Data="{DynamicResource IcoOverview}"
                                  Stroke="{DynamicResource BrFg3}" StrokeThickness="1.1"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Width="15" Height="15" Stretch="Uniform"
                                  VerticalAlignment="Center" SnapsToDevicePixels="True" />
                            <TextBlock x:Name="Txt" Text="{Binding Title}"
                                       FontFamily="{DynamicResource FontUi}"
                                       FontSize="{DynamicResource SzBody}"
                                       Foreground="{DynamicResource BrFg2}"
                                       TextOptions.TextFormattingMode="Ideal"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoOverview">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoOverview}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoGames">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoGames}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoDlss">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoDlss}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoFrameGen">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoFrameGen}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoInjection">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoInjection}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoChanges">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoChanges}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoComponents">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoComponents}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoLogs">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoLogs}" /></DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="IcoSettings">
                            <Setter TargetName="Ico" Property="Data" Value="{DynamicResource IcoSettings}" /></DataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource BrFg}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.045" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource BrFg}" />
                            <Setter TargetName="Txt" Property="FontWeight" Value="Medium" />
                            <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource BrFg}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =================================================== BOUTONS ======== -->

    <!--
        Un seul gabarit pour tous les boutons. Le survol eclaire d'un voile teinte de la
        couleur du texte : leger sur les boutons sombres, rouge sur Supprimer. L'appui
        resserre le bouton de 2 %, sans rebond.
    -->
    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="{DynamicResource CtrlH}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Grid.RenderTransform>
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RdCtrl}" />
                        <Border x:Name="Hover" Background="{TemplateBinding Foreground}"
                                CornerRadius="{DynamicResource RdCtrl}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.07" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.98" Duration="0:0:0.1" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.98" Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BrLineHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondaire : presque fondu dans la surface jusqu'au survol. -->
    <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource BrPanelAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Btn}" />

    <!-- Principal : graphite plus clair, contraste retenu. -->
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource BrPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrPrimaryLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Btn.Quiet" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrErr}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ================================================= SEGMENTE ======== -->

    <Style x:Key="Seg.Item" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
        <Setter Property="FontSize" Value="{DynamicResource SzSmall}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg2}" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Sel" Background="{DynamicResource BrRaise}" CornerRadius="5" Opacity="0" />
                        <Border x:Name="Hover" Background="{DynamicResource BrFg}" CornerRadius="5" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0.05" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.24" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource BrFg}" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Seg.Host" TargetType="ItemsControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{DynamicResource BrSunken}"
                            BorderBrush="{DynamicResource BrHair}" BorderThickness="1"
                            CornerRadius="{DynamicResource RdCtrl}" Padding="2" SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ DEFILEMENT ======= -->

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Background="{DynamicResource BrLine}"
                                                    CornerRadius="3" Margin="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{DynamicResource BrLineHi}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="T" Property="Background" Value="{DynamicResource BrFg3}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="8" />
                            <Setter Property="MinHeight" Value="8" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
