<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        JETONS DU THEME STUDIO
        ======================
        Graphite presque noir, hierarchie portee par de tres faibles ecarts de gris.
        Monochrome : l'accent vert n'est plus qu'un murmure, reserve aux etats actifs.
        La typographie et l'espace font le travail — les couleurs, presque rien.
    -->

    <!-- ===================================================== Fonds -->
    <SolidColorBrush x:Key="BrBase"      Color="#111113" />
    <SolidColorBrush x:Key="BrChrome"    Color="#0D0D0F" />
    <SolidColorBrush x:Key="BrPanel"     Color="#161618" />
    <SolidColorBrush x:Key="BrPanelAlt"  Color="#1A1A1D" />
    <SolidColorBrush x:Key="BrRaise"     Color="#232326" />
    <SolidColorBrush x:Key="BrSunken"    Color="#0F0F11" />

    <!-- ===================================================== Traits -->
    <SolidColorBrush x:Key="BrHair"      Color="#1D1D20" />
    <SolidColorBrush x:Key="BrLine"      Color="#27272B" />
    <SolidColorBrush x:Key="BrLineHi"    Color="#38383D" />

    <!-- ===================================================== Texte -->
    <SolidColorBrush x:Key="BrFg"        Color="#EDEDEF" />
    <SolidColorBrush x:Key="BrFg2"       Color="#A1A1A7" />
    <SolidColorBrush x:Key="BrFg3"       Color="#6D6D73" />
    <SolidColorBrush x:Key="BrFgDim"     Color="#47474C" />

    <!-- ===================================================== Accent -->
    <SolidColorBrush x:Key="BrAccent"    Color="#86B25C" />
    <SolidColorBrush x:Key="BrAccentDim" Color="#4E6937" />
    <SolidColorBrush x:Key="BrAccentBg"  Color="#171C13" />
    <SolidColorBrush x:Key="BrOnAccent"  Color="#0D0D0F" />

    <!-- Action principale : un graphite a peine plus clair, pas un aplat colore. -->
    <SolidColorBrush x:Key="BrPrimary"     Color="#2D2D31" />
    <SolidColorBrush x:Key="BrPrimaryLine" Color="#3E3E43" />

    <!-- ================================================== Statuts -->
    <SolidColorBrush x:Key="BrOk"        Color="#86B25C" />
    <SolidColorBrush x:Key="BrInfo"      Color="#7EA3D6" />
    <SolidColorBrush x:Key="BrWarn"      Color="#D5AD5F" />
    <SolidColorBrush x:Key="BrErr"       Color="#DA7C6E" />
    <SolidColorBrush x:Key="BrIdle"      Color="#56565C" />

    <SolidColorBrush x:Key="BrWarnBg"    Color="#1B1811" />
    <SolidColorBrush x:Key="BrErrBg"     Color="#1C1413" />
    <SolidColorBrush x:Key="BrInfoBg"    Color="#11151B" />

    <!-- ============================================ Typographie -->
    <!-- SF Pro n'est pas redistribuable sous Windows : Segoe UI Variable en est la plus
         proche parente installee, Inter en repli. -->
    <FontFamily x:Key="FontUi">Segoe UI Variable Text, Segoe UI Variable, Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontUiTight">Segoe UI Variable Display, Segoe UI Variable, Inter Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, JetBrains Mono, Consolas, monospace</FontFamily>

    <sys:Double x:Key="SzMicro">11.5</sys:Double>
    <sys:Double x:Key="SzLabel">12</sys:Double>
    <sys:Double x:Key="SzSmall">13.5</sys:Double>
    <sys:Double x:Key="SzBody">14.5</sys:Double>
    <sys:Double x:Key="SzStrong">15.5</sys:Double>
    <sys:Double x:Key="SzTitle">22</sys:Double>
    <sys:Double x:Key="SzDisplay">30</sys:Double>

    <!-- ==================================================== Formes -->
    <!-- Arrondis retenus : precision materielle, pas bulles d'application mobile. -->
    <CornerRadius x:Key="RdCtrl">7</CornerRadius>
    <CornerRadius x:Key="RdPanel">12</CornerRadius>
    <sys:Double x:Key="RowH">36</sys:Double>
    <sys:Double x:Key="CtrlH">32</sys:Double>

    <!-- ================================================ Gabarit -->
    <GridLength x:Key="TitleBarH">40</GridLength>
    <GridLength x:Key="StatusBarH">30</GridLength>
    <GridLength x:Key="RailW">236</GridLength>
    <Thickness x:Key="SysBarPad">24,14</Thickness>
    <sys:Double x:Key="NavRowH">34</sys:Double>

    <!-- ================================================ Durees -->
    <!-- Calme et reactif : 150 a 250 ms, jamais de rebond. -->
    <Duration x:Key="DurFast">0:0:0.16</Duration>
    <Duration x:Key="DurBase">0:0:0.22</Duration>

    <!-- ================================================== Icones -->
    <Geometry x:Key="IcoOverview">M2,2 H6.5 V6.5 H2 Z M9.5,2 H14 V6.5 H9.5 Z M2,9.5 H6.5 V14 H2 Z M9.5,9.5 H14 V14 H9.5 Z</Geometry>
    <Geometry x:Key="IcoGames">M1.5,3.5 H14.5 V12.5 H1.5 Z M6.5,6.5 L10,8 L6.5,9.5 Z</Geometry>
    <Geometry x:Key="IcoDlss">M4.5,4.5 H11.5 V11.5 H4.5 Z M6.5,1.5 V4.5 M9.5,1.5 V4.5 M6.5,11.5 V14.5 M9.5,11.5 V14.5 M1.5,6.5 H4.5 M1.5,9.5 H4.5 M11.5,6.5 H14.5 M11.5,9.5 H14.5</Geometry>
    <Geometry x:Key="IcoFrameGen">M1.5,5.5 H10 V14 H1.5 Z M4.5,5.5 V2.5 H13 V11 H10</Geometry>
    <Geometry x:Key="IcoChanges">M2.5,4 H13.5 M2.5,8 H9.5 M2.5,12 H11.5 M11.5,5.5 L14,8 L11.5,10.5</Geometry>
    <Geometry x:Key="IcoComponents">M8,1.5 L14.5,5 V11 L8,14.5 L1.5,11 V5 Z M1.5,5 L8,8.5 L14.5,5 M8,8.5 V14.5</Geometry>
    <Geometry x:Key="IcoInjection">M1.5,8 H9.5 M6.5,5 L9.5,8 L6.5,11 M11.5,2.5 H14.5 V13.5 H11.5</Geometry>
    <Geometry x:Key="IcoLogs">M1.5,2.5 H14.5 V13.5 H1.5 Z M4,6 L6.5,8 L4,10 M8,10.5 H12</Geometry>
    <Geometry x:Key="IcoSettings">M2,5 H14 M2,11 H14 M6,3.4 A1.6,1.6 0 1 1 6,6.6 A1.6,1.6 0 1 1 6,3.4 Z M10.5,9.4 A1.6,1.6 0 1 1 10.5,12.6 A1.6,1.6 0 1 1 10.5,9.4 Z</Geometry>

    <Geometry x:Key="IcoSearch">M7,1.8 A5.2,5.2 0 1 1 7,12.2 A5.2,5.2 0 1 1 7,1.8 Z M10.8,10.8 L14.2,14.2</Geometry>
    <Geometry x:Key="IcoRefresh">M13.5,8 A5.5,5.5 0 1 1 11.6,3.8 M11.6,1 V4 H8.6</Geometry>
    <Geometry x:Key="IcoFolder">M1.5,3.5 H6 L7.5,5.5 H14.5 V12.5 H1.5 Z</Geometry>
    <Geometry x:Key="IcoExternal">M9,2.5 H13.5 V7 M13.5,2.5 L7.5,8.5 M11,9.5 V13.5 H2.5 V5 H6.5</Geometry>
    <Geometry x:Key="IcoChevron">M3,6 L8,11 L13,6</Geometry>
    <Geometry x:Key="IcoCheck">M3,8.5 L6.5,12 L13,4.5</Geometry>
    <Geometry x:Key="IcoWarn">M8,1.8 L15,13.8 H1 Z M8,6.2 V9.6 M8,11.4 V11.9</Geometry>

    <Geometry x:Key="IcoMin">M2,8 H14</Geometry>
    <Geometry x:Key="IcoMax">M2.5,2.5 H13.5 V13.5 H2.5 Z</Geometry>
    <Geometry x:Key="IcoRestore">M4.5,4.5 H13.5 V13.5 H4.5 Z M2.5,11.5 V2.5 H11.5</Geometry>
    <Geometry x:Key="IcoClose">M3,3 L13,13 M13,3 L3,13</Geometry>

    <Geometry x:Key="MarkPrism">M11,2 L20,18 H2 Z</Geometry>
    <Geometry x:Key="MarkBeam">M0,11 H8</Geometry>
    <Geometry x:Key="MarkSpectrum">M14,10 L22,6 M14,11.5 L22,10 M14,13 L22,14</Geometry>

</ResourceDictionary>
