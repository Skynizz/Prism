<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        JETONS DE DESIGN — PRISM
        ========================
        Palette graphite quasi noire, empruntee aux outils d'ingenierie graphique.
        Un seul accent, vert NVIDIA, reserve a l'etat actif et aux points de statut :
        il ne sert jamais de remplissage decoratif.

        Les cles portent le prefixe "Br" (brush) pour ne jamais entrer en collision
        avec une cle de style.
    -->

    <!-- ===================================================== Fonds -->
    <SolidColorBrush x:Key="BrBase"      Color="#0B0C0E" /><!-- fond application -->
    <SolidColorBrush x:Key="BrChrome"    Color="#0E1013" /><!-- barre de titre, rail -->
    <SolidColorBrush x:Key="BrPanel"     Color="#121417" /><!-- panneaux -->
    <SolidColorBrush x:Key="BrPanelAlt"  Color="#15181C" /><!-- en-tetes de panneau, lignes paires -->
    <SolidColorBrush x:Key="BrRaise"     Color="#1A1E23" /><!-- survol, selection -->
    <SolidColorBrush x:Key="BrSunken"    Color="#08090B" /><!-- champs, console -->

    <!-- ===================================================== Traits -->
    <SolidColorBrush x:Key="BrHair"      Color="#1A1D22" /><!-- separateur interne -->
    <SolidColorBrush x:Key="BrLine"      Color="#23272D" /><!-- bordure standard -->
    <SolidColorBrush x:Key="BrLineHi"    Color="#31373F" /><!-- bordure au survol -->

    <!-- ===================================================== Texte -->
    <SolidColorBrush x:Key="BrFg"        Color="#E3E7EC" /><!-- primaire -->
    <SolidColorBrush x:Key="BrFg2"       Color="#949CA6" /><!-- secondaire -->
    <SolidColorBrush x:Key="BrFg3"       Color="#5F6771" /><!-- tertiaire, libelles -->
    <SolidColorBrush x:Key="BrFgDim"     Color="#434A53" /><!-- desactive -->

    <!-- ===================================================== Accent -->
    <SolidColorBrush x:Key="BrAccent"    Color="#76B900" /><!-- vert NVIDIA -->
    <SolidColorBrush x:Key="BrAccentDim" Color="#4C7A00" />
    <SolidColorBrush x:Key="BrAccentBg"  Color="#161D08" /><!-- fond d'etat actif -->
    <SolidColorBrush x:Key="BrOnAccent"  Color="#0B0C0E" />

    <!-- ================================================== Statuts -->
    <SolidColorBrush x:Key="BrOk"        Color="#76B900" />
    <SolidColorBrush x:Key="BrInfo"      Color="#5B9DD9" />
    <SolidColorBrush x:Key="BrWarn"      Color="#D3A03A" />
    <SolidColorBrush x:Key="BrErr"       Color="#D6604F" />
    <SolidColorBrush x:Key="BrIdle"      Color="#4E555E" />

    <SolidColorBrush x:Key="BrWarnBg"    Color="#1E1808" />
    <SolidColorBrush x:Key="BrErrBg"     Color="#1F0F0D" />
    <SolidColorBrush x:Key="BrInfoBg"    Color="#0C151E" />

    <!-- ============================================ Typographie -->
    <!-- Inter si presente sur le poste, repli sur la famille systeme. -->
    <FontFamily x:Key="FontUi">Inter, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontUiTight">Inter Display, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, JetBrains Mono, Consolas, monospace</FontFamily>

    <sys:Double x:Key="SzMicro">10</sys:Double>
    <sys:Double x:Key="SzLabel">10.5</sys:Double>
    <sys:Double x:Key="SzSmall">11.5</sys:Double>
    <sys:Double x:Key="SzBody">12.5</sys:Double>
    <sys:Double x:Key="SzStrong">13.5</sys:Double>
    <sys:Double x:Key="SzTitle">16</sys:Double>
    <sys:Double x:Key="SzDisplay">20</sys:Double>

    <!-- ==================================================== Formes -->
    <!-- Rayons volontairement petits : l'arrondi genereux fait "application grand
         public", pas outil technique. -->
    <CornerRadius x:Key="RdCtrl">2</CornerRadius>
    <CornerRadius x:Key="RdPanel">3</CornerRadius>
    <sys:Double x:Key="RowH">30</sys:Double>
    <sys:Double x:Key="CtrlH">26</sys:Double>

    <!-- ================================================ Gabarit -->
    <!-- Dimensions de la coquille, pour qu'un theme puisse l'aerer sans toucher aux vues. -->
    <GridLength x:Key="TitleBarH">32</GridLength>
    <GridLength x:Key="StatusBarH">26</GridLength>
    <GridLength x:Key="RailW">176</GridLength>
    <Thickness x:Key="SysBarPad">16,9</Thickness>
    <sys:Double x:Key="NavRowH">30</sys:Double>

    <!-- ================================================ Durees -->
    <!-- Rien au-dela de 160 ms : l'application doit sembler instantanee. -->
    <Duration x:Key="DurFast">0:0:0.10</Duration>
    <Duration x:Key="DurBase">0:0:0.14</Duration>

    <!-- ================================================== Icones -->
    <!-- Traces sur une grille de 16, contour seul, epaisseur 1.25. -->
    <Geometry x:Key="IcoOverview">M2,2 H6.5 V6.5 H2 Z M9.5,2 H14 V6.5 H9.5 Z M2,9.5 H6.5 V14 H2 Z M9.5,9.5 H14 V14 H9.5 Z</Geometry>
    <Geometry x:Key="IcoGames">M1.5,3.5 H14.5 V12.5 H1.5 Z M6.5,6.5 L10,8 L6.5,9.5 Z</Geometry>
    <Geometry x:Key="IcoDlss">M4.5,4.5 H11.5 V11.5 H4.5 Z M6.5,1.5 V4.5 M9.5,1.5 V4.5 M6.5,11.5 V14.5 M9.5,11.5 V14.5 M1.5,6.5 H4.5 M1.5,9.5 H4.5 M11.5,6.5 H14.5 M11.5,9.5 H14.5</Geometry>
    <Geometry x:Key="IcoFrameGen">M1.5,5.5 H10 V14 H1.5 Z M4.5,5.5 V2.5 H13 V11 H10</Geometry>
    <Geometry x:Key="IcoChanges">M2.5,4 H13.5 M2.5,8 H9.5 M2.5,12 H11.5 M11.5,5.5 L14,8 L11.5,10.5</Geometry>
    <Geometry x:Key="IcoComponents">M8,1.5 L14.5,5 V11 L8,14.5 L1.5,11 V5 Z M1.5,5 L8,8.5 L14.5,5 M8,8.5 V14.5</Geometry>
    <Geometry x:Key="IcoInjection">M1.5,8 H9.5 M6.5,5 L9.5,8 L6.5,11 M11.5,2.5 H14.5 V13.5 H11.5</Geometry>
    <Geometry x:Key="IcoLogs">M1.5,2.5 H14.5 V13.5 H1.5 Z M4,6 L6.5,8 L4,10 M8,10.5 H12</Geometry>
    <Geometry x:Key="IcoSettings">M2,5 H14 M2,11 H14 M6,3.4 A1.6,1.6 0 1 1 6,6.6 A1.6,1.6 0 1 1 6,3.4 Z M10.5,9.4 A1.6,1.6 0 1 1 10.5,12.6 A1.6,1.6 0 1 1 10.5,9.4 Z</Geometry>

    <Geometry x:Key="IcoSearch">M7,1.8 A5.2,5.2 0 1 1 7,12.2 A5.2,5.2 0 1 1 7,1.8 Z M10.8,10.8 L14.2,14.2</Geometry>
    <Geometry x:Key="IcoRefresh">M13.5,8 A5.5,5.5 0 1 1 11.6,3.8 M11.6,1 V4 H8.6</Geometry>
    <Geometry x:Key="IcoFolder">M1.5,3.5 H6 L7.5,5.5 H14.5 V12.5 H1.5 Z</Geometry>
    <Geometry x:Key="IcoExternal">M9,2.5 H13.5 V7 M13.5,2.5 L7.5,8.5 M11,9.5 V13.5 H2.5 V5 H6.5</Geometry>
    <Geometry x:Key="IcoChevron">M3,6 L8,11 L13,6</Geometry>
    <Geometry x:Key="IcoCheck">M3,8.5 L6.5,12 L13,4.5</Geometry>
    <Geometry x:Key="IcoWarn">M8,1.8 L15,13.8 H1 Z M8,6.2 V9.6 M8,11.4 V11.9</Geometry>

    <Geometry x:Key="IcoMin">M2,8 H14</Geometry>
    <Geometry x:Key="IcoMax">M2.5,2.5 H13.5 V13.5 H2.5 Z</Geometry>
    <Geometry x:Key="IcoRestore">M4.5,4.5 H13.5 V13.5 H4.5 Z M2.5,11.5 V2.5 H11.5</Geometry>
    <Geometry x:Key="IcoClose">M3,3 L13,13 M13,3 L3,13</Geometry>

    <!-- Marque : un prisme, faisceau entrant a gauche, spectre sortant a droite. -->
    <Geometry x:Key="MarkPrism">M11,2 L20,18 H2 Z</Geometry>
    <Geometry x:Key="MarkBeam">M0,11 H8</Geometry>
    <Geometry x:Key="MarkSpectrum">M14,10 L22,6 M14,11.5 L22,10 M14,13 L22,14</Geometry>

</ResourceDictionary>
