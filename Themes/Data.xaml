<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================== PANNEAU ========= -->

    <!--
        Panneau titre. Header porte le titre ; Tag accueille le contenu aligne a
        droite de l'en-tete (boutons, compteur, statut).
    -->
    <Style x:Key="S.Box" TargetType="HeaderedContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{DynamicResource BrPanel}"
                            BorderBrush="{DynamicResource BrLine}" BorderThickness="1"
                            CornerRadius="{DynamicResource RdPanel}"
                            SnapsToDevicePixels="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="32" Padding="12,0"
                                    Background="{DynamicResource BrPanelAlt}"
                                    BorderBrush="{DynamicResource BrLine}" BorderThickness="0,0,0,1"
                                    CornerRadius="2,2,0,0">
                                <Grid>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" />
                                    <ContentPresenter Content="{TemplateBinding Tag}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource T.Label}"
                               Foreground="{DynamicResource BrFg2}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================== TABLEAUX ======== -->

    <Style x:Key="S.ColHeader" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
        <Setter Property="Foreground" Value="{DynamicResource BrFg3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="S.TableHead" TargetType="Border">
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="{DynamicResource BrPanelAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Liste sans decor : le conteneur ne peint rien, chaque modele gere sa ligne. -->
    <Style x:Key="S.Rows" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!--
        Ligne de tableau : trait de separation en bas, liseré accent a gauche quand
        selectionnee. Densite volontairement elevee, 34 px.
    -->
    <Style x:Key="S.Row" TargetType="ListBoxItem">
        <!-- Sans cela l'accessibilite expose le type du modele au lieu du titre. -->
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="B" Background="Transparent"
                            BorderBrush="{DynamicResource BrHair}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Border x:Name="Edge" Width="2" HorizontalAlignment="Left"
                                    Background="Transparent" />
                            <ContentPresenter Margin="12,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrPanelAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{DynamicResource BrRaise}" />
                            <Setter TargetName="Edge" Property="Background" Value="{DynamicResource BrAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Variante non selectionnable, pour les tableaux de consultation. -->
    <Style x:Key="S.RowStatic" TargetType="ListBoxItem" BasedOn="{StaticResource S.Row}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- ================================================ ETIQUETTES ======= -->

    <!--
        Marqueur de capacite : contour fin, texte en petites capitales. Discret par
        construction — on peut en aligner cinq sans que la ligne devienne bruyante.
    -->
    <Style x:Key="S.Tag" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="T.Tag" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="{DynamicResource SzMicro}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource BrFg3}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- ================================================== BARRES ========= -->

    <Style x:Key="S.Toolbar" TargetType="Border">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource BrChrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrLine}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================================== ETAT VIDE ========== -->

    <Style x:Key="S.Empty" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,48" />
    </Style>

</ResourceDictionary>
