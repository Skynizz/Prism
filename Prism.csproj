<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Prism</AssemblyName>
    <RootNamespace>Prism</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Sur la branche dev, une etiquette -dev (1.2.0-dev.1) envoie les donnees dans %LOCALAPPDATA%\Prism-dev. -->
    <Version>1.2.0</Version>
    <Product>Prism</Product>
    <Company>Skynizz</Company>
    <Authors>Skynizz</Authors>
    <Copyright>© 2026 Skynizz</Copyright>
    <Description>Prism — DLSS 5, Multi Frame Generation, HDR RenoDX and ReShade, installed and tracked file by file.</Description>
    <!-- Icone de l'executable : explorateur, barre des taches, raccourcis. -->
    <ApplicationIcon>Assets\Prism.ico</ApplicationIcon>
    <!-- Les notices .xml des paquets (WebView2) n'ont rien a faire a cote de Prism.exe. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icone de la fenetre, et ecran natif affiche des le lancement, avant WPF. -->
    <Resource Include="Assets\Prism.ico" />
    <SplashScreen Include="Assets\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seule dependance : le controle WPF de WebView2 (Microsoft), pour la page Nexus Mods.
         Le moteur, lui, est le runtime Edge deja present sur Windows 10 et 11. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- Traductions de l'interface, lues par Core/Loc.cs. -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename)%(Extension)" />
    <!-- Signatures du diagnostic, aussi relues depuis GitHub au demarrage. -->
    <EmbeddedResource Include="Diagnostics\signatures.json" LogicalName="Diagnostics.signatures.json" />
    <!-- Regles de placement des mods Nexus, aussi relues depuis GitHub. -->
    <EmbeddedResource Include="ModRules\rules.json" LogicalName="ModRules.rules.json" />
    <!-- Catalogue des packs de shaders ReShade, aussi relu depuis GitHub. -->
    <EmbeddedResource Include="ReShadePacks\packs.json" LogicalName="ReShadePacks.packs.json" />
  </ItemGroup>

</Project>
