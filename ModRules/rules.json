{
  "version": 4,
  "_about": "Ou poser les mods Nexus, jeu par jeu. Cle = domaine Nexus (verifie via l'API GraphQL v2). Sources : extensions Vortex de Nexus Mods (github.com/Nexus-Mods/vortex-games, GPL-3.0) et, pour Cyberpunk 2077, cyberpunk2077_ext_redux (installers.layouts.ts). modRoot = dossier des mods relatif au jeu ; stopFolders = dossiers de premier niveau qui ancrent une archive sur la racine du jeu ; markers = un fichier ou dossier qui designe un dossier de mod complet ; extensions = fichiers isoles. {dir} = nom du dossier du mod, {mod} = nom du mod.",
  "games": {
    "cyberpunk2077": {
      "exe": "Cyberpunk2077.exe",
      "frameworks": [
        {
          "id": "redmod",
          "name": "REDmod (DLC)",
          "files": [
            "tools/redmod/bin/redMod.exe"
          ],
          "steamApp": 2060310,
          "neededDir": "mods",
          "neededFile": "info.json",
          "note": "health.redmod_note",
          "optional": true
        },
        {
          "id": "cet",
          "name": "Cyber Engine Tweaks",
          "nexus": 107,
          "files": [
            "bin/x64/version.dll",
            "bin/x64/plugins/cyber_engine_tweaks.asi"
          ],
          "neededDir": "bin/x64/plugins/cyber_engine_tweaks/mods",
          "neededFile": "init.lua"
        },
        {
          "id": "red4ext",
          "name": "RED4ext",
          "nexus": 2380,
          "files": [
            "red4ext/RED4ext.dll",
            "bin/x64/winmm.dll"
          ],
          "neededDir": "red4ext/plugins",
          "neededExt": [
            ".dll"
          ]
        },
        {
          "id": "redscript",
          "name": "redscript",
          "nexus": 1511,
          "files": [
            "engine/tools/scc.exe"
          ],
          "neededDir": "r6/scripts",
          "neededExt": [
            ".reds"
          ]
        },
        {
          "id": "archivexl",
          "name": "ArchiveXL",
          "nexus": 4198,
          "files": [
            "red4ext/plugins/ArchiveXL/ArchiveXL.dll"
          ],
          "neededDir": "archive/pc/mod",
          "neededExt": [
            ".xl"
          ]
        },
        {
          "id": "tweakxl",
          "name": "TweakXL",
          "nexus": 4197,
          "files": [
            "red4ext/plugins/TweakXL/TweakXL.dll"
          ],
          "neededDir": "r6/tweaks",
          "neededExt": [
            ".yaml",
            ".yml",
            ".tweak"
          ]
        }
      ],
      "logs": [
        {
          "dir": "red4ext/logs",
          "pattern": "red4ext-*.log",
          "error": "\\[(error|critical) *\\]"
        },
        {
          "dir": "r6/logs",
          "pattern": "redscript_rCURRENT.log",
          "error": "\\[ERROR"
        },
        {
          "dir": "bin/x64/plugins/cyber_engine_tweaks",
          "pattern": "cyber_engine_tweaks.log",
          "error": "\\[error\\]"
        }
      ],
      "stopFolders": [
        "archive",
        "bin",
        "engine",
        "r6",
        "red4ext",
        "mods"
      ],
      "modContainers": [
        {
          "path": "red4ext/plugins",
          "keys": [
            ".dll"
          ]
        },
        {
          "path": "bin/x64/plugins/cyber_engine_tweaks/mods",
          "keys": [
            "init.lua"
          ]
        },
        {
          "path": "r6/scripts",
          "keys": [
            ".reds"
          ]
        },
        {
          "path": "r6/tweaks",
          "keys": [
            ".yaml",
            ".yml",
            ".tweak"
          ]
        },
        {
          "path": "mods",
          "keys": [
            "info.json"
          ]
        }
      ],
      "markers": [
        {
          "file": "init.lua",
          "dest": "bin/x64/plugins/cyber_engine_tweaks/mods/{dir}"
        },
        {
          "file": "info.json",
          "withSibling": [
            "archives",
            "scripts",
            "tweaks",
            "customSounds"
          ],
          "dest": "mods/{dir}",
          "note": "nexus.note.redmod"
        }
      ],
      "extensions": [
        {
          "ext": [
            ".archive",
            ".xl"
          ],
          "dest": "archive/pc/mod"
        },
        {
          "ext": [
            ".reds"
          ],
          "dest": "r6/scripts/{mod}"
        },
        {
          "ext": [
            ".yaml",
            ".yml"
          ],
          "dest": "r6/tweaks"
        },
        {
          "ext": [
            ".asi"
          ],
          "dest": "bin/x64/plugins"
        }
      ]
    },
    "witcher3": {
      "modRoot": "Mods",
      "stopFolders": [
        "bin",
        "dlc",
        "Mods",
        "content"
      ],
      "markers": [
        {
          "dir": "content",
          "dest": "Mods/{dir}"
        }
      ]
    },
    "rimworld": {
      "modRoot": "Mods",
      "markers": [
        {
          "file": "About.xml",
          "parentName": "About",
          "up": 1,
          "dest": "Mods/{dir}"
        }
      ]
    },
    "kenshi": {
      "modRoot": "mods",
      "markers": [
        {
          "ext": ".mod",
          "dest": "mods/{dir}"
        }
      ]
    },
    "stardewvalley": {
      "modRoot": "Mods",
      "markers": [
        {
          "file": "manifest.json",
          "dest": "Mods/{dir}"
        }
      ]
    },
    "sekiro": {
      "modRoot": "mods"
    },
    "darkestdungeon": {
      "modRoot": "mods"
    },
    "x4foundations": {
      "modRoot": "extensions",
      "markers": [
        {
          "file": "content.xml",
          "dest": "extensions/{dir}"
        }
      ]
    },
    "kerbalspaceprogram": {
      "modRoot": "GameData",
      "stopFolders": [
        "GameData"
      ]
    },
    "teamfortress2": {
      "modRoot": "tf/custom"
    },
    "grimdawn": {
      "modRoot": "mods"
    },
    "dawnofman": {
      "modRoot": "Mods"
    },
    "conanexiles": {
      "modRoot": "ConanSandbox/Mods",
      "extensions": [
        {
          "ext": [
            ".pak"
          ],
          "dest": "ConanSandbox/Mods"
        }
      ]
    },
    "monsterhunterworld": {
      "modRoot": "nativePC",
      "stopFolders": [
        "nativePC"
      ]
    },
    "baldursgate3": {
      "unsupported": "nexus.note.bg3"
    }
  },
  "proxyReservations": [
    {
      "exe": "Cyberpunk2077.exe",
      "names": [
        "winmm.dll",
        "version.dll"
      ],
      "why": "RED4ext (bin/x64/winmm.dll) et Cyber Engine Tweaks (bin/x64/version.dll) : contenus Nexus des mods 2380 et 107, et RED4EXT_CORE_ONE_NINE_HOOK_DLL de cyberpunk2077_ext_redux."
    }
  ],
  "bethesda": {
    "_about": "Jeux Creation Engine / Gamebryo : un dossier Data avec des .esm. Vortex : queryModPath 'Data' (Skyrim, Fallout 3/4/NV, Oblivion, Enderal) et 'Data Files' (Morrowind).",
    "dataFolders": [
      "Data",
      "Data Files"
    ],
    "pluginExtensions": [
      ".esp",
      ".esm",
      ".esl",
      ".bsa",
      ".ba2"
    ],
    "dataStopFolders": [
      "meshes",
      "textures",
      "scripts",
      "interface",
      "sound",
      "music",
      "strings",
      "seq",
      "shadersfx",
      "lodsettings",
      "grass",
      "video",
      "materials",
      "skse",
      "f4se",
      "nvse",
      "obse",
      "fose",
      "sfse",
      "mcm",
      "calientetools",
      "netscriptframework",
      "facegen",
      "distantlod",
      "lod",
      "terrain",
      "trees",
      "shaders",
      "platform",
      "source",
      "vis",
      "geometries",
      "dialogueviews",
      "misc",
      "programs"
    ]
  },
  "_frameworks": "frameworks = chargeurs de mods du jeu. files : fichiers qui prouvent leur presence ; neededDir + neededFile/neededExt : le chargeur est exige des qu'un tel fichier existe dans ce dossier. Cyberpunk : fichiers et identifiants tires de cyberpunk2077_ext_redux (installers.layouts.ts, redmodding.metadata.ts : REDdeploy = tools/redmod/bin/redMod.exe, DLC Steam 2060310) et des contenus Nexus des mods 107, 2380, 1511, 4198, 4197. logs : journaux lus apres un lancement."
}